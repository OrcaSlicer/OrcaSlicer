msgstr "Scegli Sviluppo UV come mappatura di un livello della trama per modificarne qui le UV"

# AI Translated
#, c-format, boost-format
msgid "%d vertex selected  |  drag = move together, Shift/Ctrl click = add/remove"
msgid_plural "%d vertices selected  |  drag = move together, Shift/Ctrl click = add/remove"
msgstr[0] "%d vertice selezionato  |  trascina = sposta insieme, clic con Maiusc/Ctrl = aggiungi/rimuovi"
msgstr[1] "%d vertici selezionati  |  trascina = sposta insieme, clic con Maiusc/Ctrl = aggiungi/rimuovi"

# AI Translated
msgid "Vertex mode: drag a vertex to reshape  |  Shift/Ctrl click = multi-select, wheel = zoom, Home = frame"
msgstr "Modalità vertice: trascina un vertice per modificare la forma  |  clic con Maiusc/Ctrl = selezione multipla, rotellina = zoom, Home = inquadra"

# AI Translated
#, c-format, boost-format
msgid "%d edge selected  |  drag = move together, Shift/Ctrl click = add/remove"
msgid_plural "%d edges selected  |  drag = move together, Shift/Ctrl click = add/remove"
