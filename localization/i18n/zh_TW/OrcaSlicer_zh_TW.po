msgstr "可為 HTTPS OctoPrint 連線指定 crt/pem 格式的自訂 CA 憑證檔案。若留空，則使用作業系統預設的 CA 憑證存放區。"

msgid "User"
msgstr "使用者名稱"

msgid "Password"
