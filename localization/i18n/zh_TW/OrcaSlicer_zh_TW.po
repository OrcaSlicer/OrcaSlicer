msgid "Preferred orientation"
msgstr "首選方向"

# AI Translated
msgid "Automatically orient STL files on the Z axis upon initial import."
msgstr "首次匯入時，自動依 Z 軸調整 STL 檔案的方向。"

msgid "Printer preset names"
msgstr "列印裝置預設名稱"

