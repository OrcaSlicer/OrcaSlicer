msgstr "Mažiausias tuščios eigos greitis (M205 T)"

# AI Translated
msgid "Maximum force of the Y axis"
msgstr "Didžiausia Y ašies jėga"

# AI Translated
msgid "The allowed maximum output force of Y axis"
msgstr "Leidžiama didžiausia Y ašies išvesties jėga"

