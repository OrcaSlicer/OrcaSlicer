msgstr "Вырезать тело-инструмент из целевого тела"

# AI Translated
msgctxt "Design"
msgid "Intersect"
msgstr "Пересечение"

# AI Translated
msgid "Keep only where the two bodies overlap"
msgstr "Оставить только область пересечения двух тел"

# AI Translated
msgctxt "Design"
msgid "Surface Extrude"
msgstr "Поверхность выдавливания"

# AI Translated
msgctxt "Design"
msgid "Surface Revolve"
msgstr "Поверхность вращения"

# AI Translated
msgctxt "Design"
msgid "Surface Loft"
msgstr "Поверхность по сечениям"

# AI Translated
msgctxt "Design"
msgid "Surface Fill"
msgstr "Заливка поверхности"

# AI Translated
msgid "Create a closed sketch first"
msgstr "Сначала создайте замкнутый эскиз"

# AI Translated
msgctxt "Design"
msgid "Thicken Surface"
msgstr "Утолщение поверхности"

# AI Translated
msgid "Thicken Surface needs a surface body — make one with a Surface tool first"
msgstr "Для утолщения поверхности нужно поверхностное тело — сначала создайте его инструментом из группы «Поверхность»"

