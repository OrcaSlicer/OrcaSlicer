msgstr "Показать справку по команде."

msgid "UpToDate"
msgstr "Актуальная версия"

# ????? Обновить значения конфигурации
msgid "Update the config values of 3MF to latest."
msgstr "Обновить значения профилей 3MF файла до актуальных."

