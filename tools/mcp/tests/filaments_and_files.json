// Filament slots, exports of some objects, and imports from a ZIP archive and a STEP file, by index: filament_delete
// merges slot 2 into slot 1, and the object on slot 2 prints with slot 1; filament_add_mixed mixes slots 1 and 2 into a
// new slot, which its reply and project_get_settings name, and the same mix again names that slot; project_export writes
// object 0 alone as an STL, each object as an STL of its own into a folder, both as one DRC and each as a DRC of its
// own, and after a slice the Preview's toolpaths as an OBJ, and a script reads the files' sizes
// (fixtures/filaments_and_files.py, whose files are in the configuration folder a script may write); project_import
// takes the entries named from a ZIP archive written there, then all of its model files, and from a ZIP that holds one
// project file the objects of that project, which it adds to those there without a question. A STEP file's
// mesh options open when project_import, part_add and part_replace read it (ruling 16): each call replies
// blocked_by_dialog, the dialog is answered, and the call's job is waited for.
// Run it with
//   tools/mcp/orca_mcp.py run-replay tools/mcp/tests/filaments_and_files.json --out <dir>
{
  "orca_replay_version": "0.2.0",
  "name": "filaments and files by index",
  "vars": {
    "files": "${replay_dir}/fixtures/filaments_and_files.py",
    "undo": "${replay_dir}/fixtures/ops_undo.py",
    "step": "${replay_dir}/../../../tests/data/named_single_body.step"
  },
  "steps": [
    {"tool": "app_wait", "args": {"for": "ready"}},
    {"tool": "project_new", "args": {"discard_changes": true, "preset_changes": "discard"}},
    {"tool": "view_set", "args": {"tab": "prepare"}},

    // ---- Filament slots: slot 2 merged into slot 1, the object on it following ----
    {"tool": "filament_add", "expect": {"/filament_slot": {"eq": 2}, "/filament_slots": {"eq": 2}}},
    {"tool": "filament_add", "expect": {"/filament_slot": {"eq": 3}, "/filament_slots": {"eq": 3}}},
    {"tool": "object_add_primitive", "args": {"shape": "cube", "size": [20, 20, 20], "name": "on_two"}},
    {"tool": "settings_set", "args": {"target": "object", "object": 0, "values": {"extruder": 2}}},
    {"tool": "object_list", "expect": {"/plates/0/objects/0/filament": {"eq": 2}}},
    {"tool": "filament_delete", "args": {"filament_slot": 2, "merge_into": 1},
     "expect": {"/filament_slot": {"eq": 2}, "/merged_into": {"eq": 1}, "/filament_slots": {"eq": 2}}},
    {"tool": "object_list", "expect": {"/plates/0/objects/0/filament": {"eq": 1}}},

    // ---- A mixed filament of slots 1 and 2, in a slot after them ----
    {"tool": "filament_add_mixed", "args": {"components": [1, 2], "ratios": [50, 50]},
     "expect": {"/filament_slot": {"eq": 3}, "/added": {"eq": true}}},
    {"tool": "project_get_settings", "args": {"keys": ["filament_is_mixed"]}, "expect": {"/items/0/value": {"eq": "0,0,1"}}},
    {"tool": "app_state", "expect": {"/presets/filaments/2": {"exists": true}, "/presets/filaments/3": {"exists": false}}},
    {"tool": "filament_add_mixed", "args": {"components": [1, 2], "ratios": [50, 50]},
     "expect": {"/filament_slot": {"eq": 3}, "/added": {"eq": false}}},
    {"tool": "app_state", "expect": {"/presets/filaments/3": {"exists": false}}},

    // ---- Exports: object 0 alone as an STL, each object as an STL of its own, both as one DRC ----
    // A cube's binary STL is 84 bytes and 50 a triangle: 684 bytes for one cube's 12 triangles, 1284 for two cubes.
    {"tool": "project_new", "args": {"discard_changes": true}},
    {"tool": "object_add_primitive", "args": {"shape": "cube", "size": [20, 20, 20], "name": "small"}},
    {"tool": "object_add_primitive", "args": {"shape": "cube", "size": [30, 30, 30], "name": "big"}},
    {"tool": "script_run", "args": {"filename": "${vars.files}", "code": "import filaments_and_files\nresult = filaments_and_files.export(args)",
                                    "args": {"name": "small.stl", "format": "stl", "objects": [0]}},
     "expect": {"/result/reply/objects/0/name": {"eq": "small"}, "/result/reply/objects/1": {"exists": false},
                "/result/reply/bytes": {"eq": 684}, "/result/sizes/small.stl": {"eq": 684}}},
    {"tool": "script_run", "args": {"filename": "${vars.files}", "code": "import filaments_and_files\nresult = filaments_and_files.export(args)",
                                    "args": {"name": "both.stl", "format": "stl"}},
     "expect": {"/result/reply/objects/1/name": {"eq": "big"}, "/result/sizes/both.stl": {"eq": 1284}}},
    {"tool": "script_run", "args": {"filename": "${vars.files}", "code": "import filaments_and_files\nresult = filaments_and_files.export(args)",
                                    "args": {"name": "each", "format": "stl", "per_object": true}},
     "expect": {"/result/reply/files/1": {"exists": true}, "/result/reply/files/2": {"exists": false},
                "/result/reply/objects/1/name": {"eq": "big"}, "/result/reply/bytes": {"exists": false},
                "/result/sizes/small.stl": {"eq": 684}, "/result/sizes/big.stl": {"eq": 684}}},
    {"tool": "script_run", "args": {"filename": "${vars.files}", "code": "import filaments_and_files\nresult = filaments_and_files.export(args)",
                                    "args": {"name": "both.drc", "format": "drc"}},
     "expect": {"/result/reply/objects/1/name": {"eq": "big"}, "/result/reply/bytes": {"gt": 0}, "/result/sizes/both.drc": {"gt": 0}}},
    {"tool": "script_run", "args": {"filename": "${vars.files}", "code": "import filaments_and_files\nresult = filaments_and_files.export(args)",
                                    "args": {"name": "each_drc", "format": "drc", "per_object": true}},
     "expect": {"/result/reply/files/1": {"exists": true}, "/result/reply/files/2": {"exists": false},
                "/result/sizes/small.drc": {"gt": 0}, "/result/sizes/big.drc": {"gt": 0}}},
    // The toolpaths the Preview shows, once the plate is sliced and shown there.
    {"tool": "plate_slice", "args": {"preview": true}, "expect": {"/plates/0/outcome": {"eq": "ok"}}},
    {"tool": "script_run", "args": {"filename": "${vars.files}", "code": "import filaments_and_files\nresult = filaments_and_files.export(args)",
                                    "args": {"name": "toolpaths.obj", "format": "toolpaths_obj"}},
     "expect": {"/result/reply/bytes": {"gt": 0}, "/result/sizes/toolpaths.obj": {"gt": 0}}},
    {"tool": "view_set", "args": {"tab": "prepare"}},

    // ---- A ZIP archive: the entries named, then every model file; a text file beside them is no model ----
    {"tool": "project_new", "args": {"discard_changes": true}},
    {"tool": "script_run", "args": {"filename": "${vars.files}", "code": "import filaments_and_files\nresult = filaments_and_files.write_zip(args)",
                                    "args": {"name": "cubes.zip", "cubes": {"small.stl": 10, "parts/middle.stl": 15, "parts/large.stl": 20}}}},
    {"tool": "script_run", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"}},
    {"tool": "script_run", "args": {"filename": "${vars.files}", "code": "import filaments_and_files\nresult = filaments_and_files.import_zip(args)",
                                    "args": {"name": "cubes.zip", "entries": ["small.stl", "parts/large.stl"]}},
     "expect": {"/result/added": {"eq": 2}, "/result/archives/0/entries": {"eq": ["small.stl", "parts/large.stl"]},
                "/result/archives/1": {"exists": false}}},
    // The loader adds the files taken in the order of their names.
    {"tool": "object_list", "expect": {"/total": {"eq": 2}, "/plates/0/objects/0/name": {"eq": "large.stl"},
                                       "/plates/0/objects/0/parts/0/mesh_volume": {"eq": 8000},
                                       "/plates/0/objects/1/name": {"eq": "small.stl"},
                                       "/plates/0/objects/1/parts/0/mesh_volume": {"eq": 1000}}},
    {"tool": "script_run", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"},
     "expect": {"/result/taken": {"eq": ["Import Objects: cubes.zip"]}}},
    {"tool": "app_state", "expect": {"/dialogs": {"empty": true}}},
    {"tool": "project_new", "args": {"discard_changes": true}},
    {"tool": "script_run", "args": {"filename": "${vars.files}", "code": "import filaments_and_files\nresult = filaments_and_files.import_zip(args)",
                                    "args": {"name": "cubes.zip"}},
     "expect": {"/result/added": {"eq": 3}, "/result/archives/0/entries/2": {"exists": true},
                "/result/archives/0/entries/3": {"exists": false}}},
    {"tool": "object_list", "expect": {"/total": {"eq": 3}}},

    // ---- A ZIP that holds one project file: its objects join those there, as a .3mf in paths gives them ----
    {"tool": "project_new", "args": {"discard_changes": true}},
    {"tool": "object_add_primitive", "args": {"shape": "cube", "size": [10, 10, 10], "name": "inside_zip"}},
    {"tool": "script_run", "args": {"filename": "${vars.files}", "code": "import filaments_and_files\nresult = filaments_and_files.write_project_zip(args)",
                                    "args": {"name": "project.zip"}}},
    {"tool": "project_new", "args": {"discard_changes": true}},
    {"tool": "object_add_primitive", "args": {"shape": "cube", "size": [20, 20, 20], "name": "first"}},
    {"tool": "object_add_primitive", "args": {"shape": "cube", "size": [30, 30, 30], "name": "second"}},
    {"tool": "script_run", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"}},
    {"tool": "script_run", "args": {"filename": "${vars.files}", "code": "import filaments_and_files\nresult = filaments_and_files.import_zip(args)",
                                    "args": {"name": "project.zip"}},
     "expect": {"/result/added": {"eq": 1}, "/result/archives/0/entries": {"eq": ["project.3mf"]}}},
    {"tool": "object_list", "expect": {"/total": {"eq": 3}, "/plates/0/objects/0/name": {"eq": "first"},
                                       "/plates/0/objects/1/name": {"eq": "second"},
                                       "/plates/0/objects/2/name": {"eq": "inside_zip"}}},
    {"tool": "app_state", "expect": {"/dialogs": {"empty": true}, "/project/path": {"eq": ""}}},
    {"tool": "script_run", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"},
     "expect": {"/result/taken": {"eq": ["Import Objects: project.zip"]}}},

    // ---- A STEP file's mesh options open for project_import, part_add and part_replace, and are answered ----
    {"tool": "project_new", "args": {"discard_changes": true}},
    {"tool": "project_import", "args": {"paths": ["${vars.step}"]}, "await": false, "save_as": "step_import"},
    {"tool": "app_wait", "args": {"for": "dialog"}},
    {"tool": "dialog_answer", "args": {"dialog": {"title": "STEP file import parameters"}, "button": "ok"}},
    {"tool": "app_wait", "args": {"for": "job", "job": "${jobs.step_import}"}},
    {"tool": "object_list", "expect": {"/total": {"eq": 1}, "/plates/0/objects/0/parts/0": {"exists": true},
                                       "/plates/0/objects/0/parts/1": {"exists": false}}},
    {"tool": "part_add", "args": {"object": 0, "type": "part", "path": "${vars.step}"}, "await": false, "save_as": "step_part"},
    {"tool": "app_wait", "args": {"for": "dialog"}},
    {"tool": "dialog_answer", "args": {"dialog": {"title": "STEP file import parameters"}, "button": "ok"}},
    {"tool": "app_wait", "args": {"for": "job", "job": "${jobs.step_part}"}},
    {"tool": "object_list", "expect": {"/total": {"eq": 1}, "/plates/0/objects/0/parts/1": {"exists": true}}},
    {"tool": "part_replace", "args": {"object": 0, "part": 1, "path": "${vars.step}"}, "await": false, "save_as": "step_replace"},
    {"tool": "app_wait", "args": {"for": "dialog"}},
    {"tool": "dialog_answer", "args": {"dialog": {"title": "STEP file import parameters"}, "button": "ok"}},
    {"tool": "app_wait", "args": {"for": "job", "job": "${jobs.step_replace}"}},
    {"tool": "object_list", "expect": {"/total": {"eq": 1}, "/plates/0/objects/0/parts/1": {"exists": true},
                                       "/plates/0/objects/0/parts/2": {"exists": false}}},
    {"tool": "app_state", "expect": {"/dialogs": {"empty": true}}},
    {"tool": "project_new", "args": {"discard_changes": true}}
  ]
}
