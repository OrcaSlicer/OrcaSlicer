// Recordings: one while the GUI is driven (clicks on the 3D view, a setting typed, a dialog opened and
// answered, a slice), stopped and encoded; then one a nested replay starts and never stops, which ends
// with that replay and is encoded by a step after it. Run with
//   tools/mcp/orca_mcp.py run-replay tools/mcp/tests/recording.json --out /tmp/recording
// The encode steps need an ffmpeg with libx265 (ORCA_FFMPEG or on PATH), so they are optional.
{
  "orca_replay_version": "0.2.0",
  "name": "recording",
  "vars": {"model": "${replay_dir}/../../../resources/handy_models/OrcaCube_v2.drc"},
  "steps": [
    {"tool": "app_wait", "args": {"for": "ready"}},
    {"tool": "dialog_auto_answer", "args": {"rules": [{"match": "unsaved changes", "button": "no"},
                                                     {"match": "restore", "button": "no"}]}},
    {"tool": "project_new", "args": {"silent": true}},
    {"tool": "window_set", "args": {"size": [1600, 900]}},
    {"tool": "view_set", "args": {"tab": "prepare"}},
    {"tool": "recording_start", "args": {"save_path": "${out_dir}/session.mkv", "overwrite": true, "captions": true,
                                         "pointer": true},
     "expect": {"/width": {"ge": 320}, "/fps": {"eq": 10}, "/captions": {"eq": true}, "/pointer": {"eq": true}}},
    {"tool": "app_state", "expect": {"/recording/path": {"regex": "session\\.mkv$"}}},
    {"tool": "project_import", "args": {"paths": ["${vars.model}"]}, "expect": {"/added": {"eq": 1}}},
    {"tool": "mouse_gesture", "args": {"action": "click", "x": 300, "y": 200}},
    {"tool": "mouse_gesture", "args": {"action": "click", "at": {"object": 0, "spot": "top"}}},
    // The global settings, whatever an earlier replay left the Process panel's Global/Objects switch on.
    {"tool": "widget_set_value", "args": {"target": {"label": "Process"}, "value": false}},
    {"tool": "widget_set_value", "args": {"target": {"option": "layer_height"}, "value": "0.16"}},
    {"tool": "keyboard_press", "args": {"target": {"option": "initial_layer_print_height"}, "keys": "ctrl+a", "text": "0.24"}},

    // The action blocks in the dialog it opens, so it is not awaited until the dialog is answered.
    {"tool": "action_run", "args": {"id": "orca_command:open_preferences:orca"}, "await": false, "save_as": "prefs"},
    {"tool": "app_wait", "args": {"for": "dialog", "timeout_s": 10}, "expect": {"/satisfied": {"eq": true}}},
    {"tool": "dialog_answer", "args": {"dialog": {"title": "Preferences"}, "button": "close"}},
    {"tool": "app_wait", "args": {"for": "job", "job": "${jobs.prefs}"}},

    {"tool": "plate_slice", "expect": {"/plates/0/outcome": {"eq": "ok"}}},
    {"tool": "app_wait", "args": {"for": "idle"}},
    {"tool": "recording_stop", "args": {"silent": true},
     "expect": {"/ended": {"eq": "stopped"}, "/frames": {"ge": 5}, "/written": {"ge": 5}, "/seconds": {"gt": 1}, "/size_bytes": {"gt": 0},
                "/capture_ms": {"gt": 0}}},
    {"tool": "app_state", "expect": {"/recording": {"exists": false}}},
    {"tool": "recording_encode", "args": {"save_path": "${out_dir}/session.mp4", "overwrite": true, "keep_raw_video_file": true},
     "optional": true,
     "expect": {"/codec": {"eq": "h265"}, "/encoder": {"eq": "libx265"}, "/seconds": {"gt": 1}, "/raw_video_file_deleted": {"eq": false}}},

    // A recording a replay starts ends with that replay, its file closed when the replay's call returns.
    {"tool": "replay_run", "args": {"replay": {"orca_replay_version": "0.2.0", "name": "inner", "steps": [
       {"tool": "recording_start", "args": {"target": "canvas", "fps": 5, "save_path": "${out_dir}/inner.mkv", "overwrite": true}},
       {"tool": "view_set", "args": {"camera": "iso"}},
       {"tool": "mouse_gesture", "args": {"action": "drag", "x": 400, "y": 300, "to": [500, 340]}}]}},
     "expect": {"/passed": {"eq": true}, "/unfinished_recording": {"exists": false}}},
    {"tool": "recording_stop", "args": {"silent": true}, "expect": {"/ended": {"eq": "run_ended"}, "/path": {"regex": "inner\\.mkv$"}}},
    {"tool": "recording_encode", "args": {"overwrite": true, "codec": "h264"}, "optional": true,
     "expect": {"/path": {"regex": "inner\\.mp4$"}, "/encoder": {"eq": "libx264"}, "/raw_video_file_deleted": {"eq": true}}},
    // The replay's end released the file: recording to it again starts at once, with no overlays by default.
    {"tool": "recording_start", "args": {"save_path": "${out_dir}/inner.mkv", "overwrite": true},
     "expect": {"/captions": {"eq": false}, "/pointer": {"eq": false}}},
    {"tool": "recording_stop", "args": {"silent": true}, "expect": {"/ended": {"eq": "stopped"}}},

    // captions and pointer each turn on one.
    {"tool": "recording_start", "args": {"save_path": "${out_dir}/plain.mkv", "overwrite": true, "pointer": true},
     "expect": {"/captions": {"eq": false}, "/pointer": {"eq": true}}},
    {"tool": "recording_stop", "args": {"silent": true}, "expect": {"/ended": {"eq": "stopped"}}},
    {"tool": "recording_start", "args": {"save_path": "${out_dir}/plain.mkv", "overwrite": true, "captions": true},
     "expect": {"/captions": {"eq": true}, "/pointer": {"eq": false}}},
    {"tool": "recording_stop", "args": {"silent": true}, "expect": {"/ended": {"eq": "stopped"}}},
    // Left out, the limit is an hour, and the reply says so.
    {"tool": "recording_start", "args": {"save_path": "${out_dir}/limit.mkv", "overwrite": true},
     "expect": {"/max_seconds": {"eq": 3600}}},
    {"tool": "recording_stop", "args": {"silent": true}, "expect": {"/ended": {"eq": "stopped"}}},

    // Encoding asked for up front (an ffmpeg with libx264): the stop that reports the recording starts the encode
    // as a job of its own, which app_wait idle waits for, and the encode deletes the .mkv once the MP4 is written.
    {"tool": "recording_start", "args": {"save_path": "${out_dir}/encoded.mkv", "overwrite": true, "encode": true,
                                         "encode_preset": "compatible", "crf": 30}, "optional": true,
     "expect": {"/encode/codec": {"eq": "h264"}, "/encode/crf": {"eq": 30}, "/encode/profile": {"eq": "high"},
                "/encode/keep_raw_video_file": {"eq": false}}},
    {"tool": "recording_stop", "args": {"silent": true}, "optional": true,
     "expect": {"/path": {"regex": "encoded\\.mkv$"}, "/encode/status": {"eq": "running"}, "/encode/job": {"exists": true}}},
    {"tool": "app_wait", "args": {"for": "idle", "timeout_s": 50}, "optional": true, "expect": {"/satisfied": {"eq": true}}},
    {"tool": "app_state", "optional": true,
     "expect": {"/jobs/0/tool": {"eq": "recording_encode"}, "/jobs/0/state": {"eq": "done"}}},
    {"tool": "script_run", "args": {"code": "import os\nresult = {name: os.path.exists(path) for name, path in args.items()}",
                                    "args": {"mkv": "${out_dir}/encoded.mkv", "mp4": "${out_dir}/encoded.mp4"}}, "optional": true,
     "expect": {"/result/mkv": {"eq": false}, "/result/mp4": {"eq": true}}},
    // keep_raw_video_file keeps the .mkv beside the MP4.
    {"tool": "recording_start", "args": {"save_path": "${out_dir}/kept.mkv", "overwrite": true, "encode": true,
                                         "encode_preset": "compatible", "keep_raw_video_file": true}, "optional": true,
     "expect": {"/encode/keep_raw_video_file": {"eq": true}}},
    {"tool": "recording_stop", "args": {"silent": true}, "optional": true, "expect": {"/encode/job": {"exists": true}}},
    {"tool": "app_wait", "args": {"for": "idle", "timeout_s": 50}, "optional": true, "expect": {"/satisfied": {"eq": true}}},
    {"tool": "script_run", "args": {"code": "import os\nresult = {name: os.path.exists(path) for name, path in args.items()}",
                                    "args": {"mkv": "${out_dir}/kept.mkv", "mp4": "${out_dir}/kept.mp4"}}, "optional": true,
     "expect": {"/result/mkv": {"eq": true}, "/result/mp4": {"eq": true}}}
  ]
}
