// Object structure and scene: transform on instances, plates and parts, shapes added at a size
// without the Primitive size dialog, arrange, parts added to an object with add_part, and the object
// list's context-menu commands (Change Type, Rename, instances, Assemble, Order By), then all of them
// on one scene from start to slice. Run on a live app:
//   python3 tools/mcp/orca_mcp.py run-script tools/mcp/tests/scene.json --out <dir>
// A refusal can't be asserted directly (a failed step stops the run), so each one is an optional
// step followed by a check that nothing changed.
{
  "orca_script": 1,
  "name": "object structure and scene",
  "vars": {"cube": "${script_dir}/../../../resources/handy_models/OrcaCube_v2.drc",
           "svg": "${script_dir}/fixtures/star.svg"},
  "steps": [
    {"tool": "wait", "args": {"for": "ready"}},
    {"tool": "new_project", "args": {"discard_changes": true}},
    {"tool": "set_view", "args": {"tab": "prepare"}},

    // ---- An instance: a scale that grows it drops it onto the bed; size keeps the proportions ----
    {"tool": "open_files", "args": {"paths": ["${vars.cube}"]}, "expect": {"/added": {"eq": 1}}},
    {"tool": "transform", "args": {"object": 0, "scale": 1.5}},
    {"tool": "list_objects", "expect": {"/items/0/bbox/min/2": {"ge": -0.001, "le": 0.001}}},
    {"tool": "transform", "args": {"object": 0, "size": [30, null, null]}},
    {"tool": "list_objects", "expect": {"/items/0/bbox/size/0": {"ge": 29.99, "le": 30.01},
                                        "/items/0/bbox/min/2": {"ge": -0.001, "le": 0.001}}},
    {"tool": "transform", "args": {"object": 0, "size": [30, 20, 10]}},
    {"tool": "list_objects", "expect": {"/items/0/bbox/size/1": {"ge": 19.99, "le": 20.01},
                                        "/items/0/bbox/size/2": {"ge": 9.99, "le": 10.01}}},
    {"tool": "transform", "args": {"object": 0, "size": [30, 30, 30]}},

    // ---- A move to another plate registers the instance there, for list_objects and slicing ----
    {"tool": "run_action", "args": {"id": "orca_command:plate_add:orca"}},
    {"tool": "transform", "args": {"object": 0, "plate": 1}, "expect": {"/plate": {"eq": 1}}},
    {"tool": "list_objects", "args": {"plate": 1}, "expect": {"/total": {"eq": 1}, "/items/0/instances/0/plate": {"eq": 1}}},
    {"tool": "transform", "args": {"object": 0, "plate": 0}, "expect": {"/plate": {"eq": 0}}},
    {"tool": "transform", "args": {"object": 0, "translate": [100, 100, 0], "mode": "absolute"},
     "expect": {"/offset/0": {"ge": 99.99, "le": 100.01}, "/plate": {"eq": 0}}},

    // ---- A part: the Object manipulation panel's path, measured on instance 0 ----
    {"tool": "select", "args": {"objects": [0]}},
    {"tool": "run_action", "args": {"id": "orca_command:add_primitive_svg:orca", "param": "${vars.svg}"}},
    {"tool": "wait", "args": {"for": "idle"}},
    {"tool": "ui_click", "args": {"target": {"gizmo": "SVG"}}},
    {"tool": "list_objects", "expect": {"/items/0/volumes/1/svg/path": {"contains": "star.svg"}}},
    {"tool": "transform", "args": {"object": 0, "volume": 1, "translate": [100, 100, 15], "mode": "absolute"},
     "expect": {"/volume_info/position/0": {"ge": 99.99, "le": 100.01}, "/volume_info/position/1": {"ge": 99.99, "le": 100.01},
                "/volume_info/position/2": {"ge": 14.99, "le": 15.01}, "/volume_info/type": {"eq": "part"}}},
    {"tool": "transform", "args": {"object": 0, "volume": 1, "translate": [5, 0, 0]},
     "expect": {"/volume_info/position/0": {"ge": 104.99, "le": 105.01}}},
    // one undo step per call
    {"tool": "run_action", "args": {"id": "orca_command:undo:orca"}},
    {"tool": "transform", "args": {"object": 0, "volume": 1, "translate": [0, 0, 0]},
     "expect": {"/volume_info/position/0": {"ge": 99.99, "le": 100.01}}},
    {"tool": "transform", "args": {"object": 0, "volume": 1, "scale": 2, "mode": "absolute"},
     "expect": {"/volume_info/scale/0": {"ge": 1.999, "le": 2.001}, "/volume_info/scale/2": {"ge": 1.999, "le": 2.001}}},
    {"tool": "transform", "args": {"object": 0, "volume": 1, "size": [null, null, 3]},
     "expect": {"/size/2": {"ge": 2.999, "le": 3.001}}},
    {"tool": "transform", "args": {"object": 0, "volume": 1, "rotate": [0, 0, 45]}},
    // refused: an absolute rotation of a part, a part with plate, a single part
    {"tool": "transform", "args": {"object": 0, "volume": 1, "rotate": [0, 0, 0], "mode": "absolute"}, "optional": true},
    {"tool": "transform", "args": {"object": 0, "volume": 1, "plate": 1}, "optional": true},
    {"tool": "list_objects", "expect": {"/items/0/instances/0/plate": {"eq": 0}}},

    // ---- What list_objects says of the part and the instance: placement on the bed, filament, mirror ----
    // The star stands on the face the camera saw, so only orientation-free values are checked; a turn
    // about Z keeps its height, and at 0.3 of its size it holds 0.027 of its mesh's volume.
    {"tool": "list_objects", "expect": {"/items/0/filament": {"eq": 1}, "/items/0/auto_drop": {"eq": true},
                                        "/items/0/instances/0/mirrored": {"eq": false},
                                        "/items/0/instances/0/bbox/min/2": {"ge": -0.001, "le": 0.001},
                                        "/items/0/instances/0/bbox/size/0": {"ge": 29.99, "le": 30.01},
                                        "/items/0/volumes/1/filament": {"eq": 1}, "/items/0/volumes/1/mirrored": {"eq": false},
                                        "/items/0/volumes/1/position/2": {"ge": 14.99, "le": 15.01},
                                        "/items/0/volumes/1/bbox/min/2": {"gt": 0, "le": 15},
                                        "/items/0/volumes/1/bbox/max/2": {"ge": 15, "lt": 30},
                                        "/items/0/volumes/1/mesh_volume": {"gt": 1000},
                                        "/items/0/volumes/1/scaled_volume": {"gt": 0, "lt": 100}}},
    // a mirrored part is mirrored in the object's frame; an instance mirrored twice is a half turn
    {"tool": "select", "args": {"volumes": [[0, 1]]}},
    {"tool": "run_action", "args": {"id": "orca_command:obj_mirror_x:orca"}},
    {"tool": "list_objects", "expect": {"/items/0/volumes/1/mirrored": {"eq": true}, "/items/0/instances/0/mirrored": {"eq": false}}},
    {"tool": "select", "args": {"objects": [0]}},
    {"tool": "run_action", "args": {"id": "orca_command:obj_mirror_y:orca"}},
    {"tool": "list_objects", "expect": {"/items/0/instances/0/mirrored": {"eq": true}, "/items/0/instances/0/scale/0": {"gt": 0},
                                        "/items/0/volumes/1/mirrored": {"eq": true}}},
    {"tool": "run_action", "args": {"id": "orca_command:obj_mirror_x:orca"}},
    {"tool": "list_objects", "expect": {"/items/0/instances/0/mirrored": {"eq": false}}},

    // ---- Shapes at a size, without the dialog ----
    {"tool": "select", "args": {"none": true}},
    {"tool": "run_action", "args": {"id": "orca_command:add_primitive_cube:orca", "param": "40 40 10"}},
    {"tool": "list_objects", "expect": {"/total": {"eq": 2}, "/items/1/bbox/size/0": {"ge": 39.99, "le": 40.01},
                                        "/items/1/bbox/size/2": {"ge": 9.99, "le": 10.01}}},
    {"tool": "transform", "args": {"object": 1, "volume": 0, "translate": [1, 0, 0]}, "optional": true},
    // a wrong count adds nothing
    {"tool": "select", "args": {"none": true}},
    {"tool": "run_action", "args": {"id": "orca_command:add_primitive_cylinder:orca", "param": "1 2 3"}, "optional": true},
    {"tool": "list_objects", "expect": {"/total": {"eq": 2}}},
    // with an object selected, an error instead of a silent success
    {"tool": "select", "args": {"objects": [1]}},
    {"tool": "run_action", "args": {"id": "orca_command:add_primitive_cylinder:orca", "param": "10 5"}, "optional": true},
    {"tool": "list_objects", "expect": {"/total": {"eq": 2}}},
    {"tool": "select", "args": {"none": true}},
    {"tool": "run_action", "args": {"id": "orca_command:add_primitive_cylinder:orca", "param": "10 5"}},
    {"tool": "list_objects", "expect": {"/total": {"eq": 3}}},

    // ---- Fill bed fills the object's own plate, in one undo step ----
    // The shapes were added on the current plate, plate 1; the cube goes back to plate 0.
    {"tool": "transform", "args": {"object": 1, "plate": 0}, "expect": {"/plate": {"eq": 0}}},
    {"tool": "arrange", "args": {"fill": 2}, "expect": {"/added": {"gt": 0}, "/plate": {"eq": 1}, "/off_plate": {"empty": true}}},
    {"tool": "list_objects", "expect": {"/items/2/instances/1": {"exists": true}}},
    {"tool": "run_action", "args": {"id": "orca_command:undo:orca"}},
    {"tool": "list_objects", "expect": {"/items/2/instances/1": {"exists": false}}},
    // refused: a locked plate, a plate that does not exist, fill with plates
    {"tool": "run_action", "args": {"id": "orca_command:plate_goto:orca", "param": "1"}},
    {"tool": "run_action", "args": {"id": "orca_command:plate_toggle_lock:orca"}},
    {"tool": "arrange", "args": {"plates": 1}, "optional": true},
    {"tool": "run_action", "args": {"id": "orca_command:plate_toggle_lock:orca"}},
    {"tool": "arrange", "args": {"plates": 7}, "optional": true},
    {"tool": "arrange", "args": {"fill": 0, "plates": 0}, "optional": true},
    {"tool": "list_objects", "expect": {"/plates": {"eq": 2}, "/items/2/instances/0/plate": {"eq": 1},
                                        "/items/2/instances/1": {"exists": false}}},

    // ---- Arrange one plate with options; the other plate keeps its object (arrange may reorder objects) ----
    {"tool": "arrange", "args": {"plates": 0, "spacing": 10, "rotate": false, "align_y": false},
     "expect": {"/off_plate": {"empty": true}, "/plates": {"eq": 2}, "/settings/spacing": {"eq": 10},
                "/settings/rotate": {"eq": false}}},
    {"tool": "list_objects", "args": {"plate": 1}, "expect": {"/total": {"eq": 1}, "/items/0/name": {"eq": "Cylinder"}}},
    {"tool": "list_objects", "args": {"plate": 0}, "expect": {"/total": {"eq": 2}}},
    // every plate with the saved options; obj_arrange runs the same job and returns once it is done
    {"tool": "arrange", "expect": {"/settings/spacing": {"eq": 10}, "/off_plate": {"empty": true}}},
    {"tool": "run_action", "args": {"id": "orca_command:obj_arrange:orca"}, "expect": {"/level": {"eq": "success"}}},
    // a Speed Dial command that does nothing (no selection) is an error step
    {"tool": "select", "args": {"none": true}},
    {"tool": "run_action", "args": {"id": "orca_command:obj_mirror_x:orca"}, "optional": true},

    // ---- add_part: the context menu's Add items, with a size, a file or a position, one undo step each ----
    {"tool": "new_project", "args": {"discard_changes": true}},
    {"tool": "run_action", "args": {"id": "orca_command:add_primitive_cube:orca", "param": "40 40 10"}},
    {"tool": "transform", "args": {"object": 0, "translate": [100, 100, 5], "mode": "absolute"}},
    // a magnet pocket at the bottom centre
    {"tool": "add_part", "args": {"object": 0, "type": "negative", "shape": "cylinder", "size": [6.2, 3.2],
                                  "position": [100, 100, 1.6]},
     "expect": {"/volume": {"eq": 1}, "/volume_count": {"eq": 2}, "/volume_info/type": {"eq": "negative"},
                "/volume_info/position/0": {"ge": 99.99, "le": 100.01}, "/volume_info/position/1": {"ge": 99.99, "le": 100.01},
                "/volume_info/bbox/min/2": {"ge": -0.01, "le": 0.01}, "/volume_info/bbox/size/2": {"ge": 3.19, "le": 3.21},
                "/volume_info/bbox/size/0": {"ge": 6.1, "le": 6.21}}},
    {"tool": "list_objects", "expect": {"/items/0/volumes/1/mesh_volume": {"gt": 90},
                                        "/items/0/bbox/size/2": {"ge": 9.99, "le": 10.01}}},
    {"tool": "run_action", "args": {"id": "orca_command:undo:orca"}},
    {"tool": "list_objects", "expect": {"/items/0/volumes/1": {"exists": false}}},
    {"tool": "run_action", "args": {"id": "orca_command:redo:orca"}},
    {"tool": "list_objects", "expect": {"/items/0/volumes/1/type": {"eq": "negative"}}},
    // a modifier from a file, where Load... puts it; parts are ordered by type (part, negative, modifier)
    {"tool": "add_part", "args": {"object": 0, "type": "modifier", "path": "${vars.cube}"},
     "expect": {"/volume": {"eq": 2}, "/volume_count": {"eq": 3}, "/volume_info/type": {"eq": "modifier"},
                "/volume_info/name": {"eq": "OrcaCube_v2.drc"}}},
    // a solid part at a size takes the object's filament and grows the object; the built-in size for the rest
    {"tool": "add_part", "args": {"object": 0, "type": "part", "shape": "cube", "size": [10, 10, 20], "position": [125, 100, 10]},
     "expect": {"/volume": {"eq": 1}, "/volume_info/type": {"eq": "part"}, "/volume_info/filament": {"eq": 1},
                "/volume_info/bbox/size/2": {"ge": 19.99, "le": 20.01}}},
    {"tool": "add_part", "args": {"object": 0, "type": "support_blocker", "shape": "sphere", "position": [110, 110, 10]},
     "expect": {"/volume_info/type": {"eq": "support_blocker"}, "/volume_info/position/2": {"ge": 9.99, "le": 10.01}}},
    {"tool": "add_part", "args": {"object": 0, "type": "precise_seam", "shape": "cube", "size": [2, 2, 2]},
     "expect": {"/volume_info/type": {"eq": "precise_seam"}, "/volume_info/subtype": {"eq": "center"}}},
    {"tool": "list_objects", "expect": {"/items/0/volumes/2/type": {"eq": "negative"}, "/items/0/volumes/3/type": {"eq": "modifier"},
                                        "/items/0/volumes/5": {"exists": true}, "/items/0/volumes/6": {"exists": false},
                                        "/items/0/bbox/size/2": {"ge": 19.99, "le": 20.01}}},
    // refused, adding nothing: shape and path, a size with the wrong count, an SVG file, a file that is
    // not a model, an object with two instances
    {"tool": "add_part", "args": {"object": 0, "type": "modifier", "shape": "cube", "path": "${vars.cube}"}, "optional": true},
    {"tool": "add_part", "args": {"object": 0, "type": "modifier", "shape": "cylinder", "size": [1, 2, 3]}, "optional": true},
    {"tool": "add_part", "args": {"object": 0, "type": "part", "path": "${vars.svg}"}, "optional": true},
    {"tool": "add_part", "args": {"object": 0, "type": "modifier", "path": "${script_dir}/fixtures/heightmap.png"}, "optional": true},
    {"tool": "select", "args": {"objects": [0]}},
    {"tool": "run_action", "args": {"id": "orca_command:obj_instances_up:orca"}},
    {"tool": "add_part", "args": {"object": 0, "type": "modifier", "shape": "cube"}, "optional": true},
    {"tool": "list_objects", "expect": {"/items/0/volumes/6": {"exists": false}, "/items/0/instances/1": {"exists": true}}},
    {"tool": "run_action", "args": {"id": "orca_command:obj_instances_down:orca"}},
    // a shape folds the instance's scale into the parts, as the menu does
    {"tool": "select", "args": {"none": true}},
    {"tool": "run_action", "args": {"id": "orca_command:add_primitive_cube:orca", "param": "20 20 20"}},
    {"tool": "transform", "args": {"object": 1, "scale": 1.5}},
    {"tool": "add_part", "args": {"object": 1, "type": "modifier", "shape": "cube"}, "expect": {"/volume": {"eq": 1}}},
    {"tool": "list_objects", "expect": {"/items/1/instances/0/scale/0": {"ge": 0.999, "le": 1.001},
                                        "/items/1/bbox/size/0": {"ge": 29.99, "le": 30.01},
                                        "/items/1/volumes/0/scale/0": {"ge": 1.499, "le": 1.501}}},

    // ---- Object structure commands: the context menus' Change Type, Rename, number of instances,
    // Set as Individual Objects and Assemble, each a run_action on what select picked ----
    {"tool": "new_project", "args": {"discard_changes": true}},
    {"tool": "run_action", "args": {"id": "orca_command:add_primitive_cube:orca", "param": "30 30 10"}},
    {"tool": "add_part", "args": {"object": 0, "type": "modifier", "shape": "cube", "size": [10, 10, 10]}, "expect": {"/volume": {"eq": 1}}},
    // Change Type, one undo step each; a seam made a part again is listed after the first part
    {"tool": "select", "args": {"volumes": [[0, 1]]}},
    {"tool": "run_action", "args": {"id": "orca_command:obj_type_negative:orca"}, "expect": {"/level": {"eq": "success"}}},
    {"tool": "list_objects", "expect": {"/items/0/volumes/1/type": {"eq": "negative"}}},
    {"tool": "run_action", "args": {"id": "orca_command:obj_type_support_blocker:orca"}},
    {"tool": "list_objects", "expect": {"/items/0/volumes/1/type": {"eq": "support_blocker"}}},
    {"tool": "run_action", "args": {"id": "orca_command:undo:orca"}},
    {"tool": "list_objects", "expect": {"/items/0/volumes/1/type": {"eq": "negative"}}},
    {"tool": "select", "args": {"volumes": [[0, 1]]}},
    {"tool": "run_action", "args": {"id": "orca_command:obj_type_precise_seam:orca"}},
    {"tool": "list_objects", "expect": {"/items/0/volumes/1/type": {"eq": "precise_seam"}, "/items/0/volumes/1/subtype": {"eq": "center"}}},
    {"tool": "select", "args": {"volumes": [[0, 1]]}},
    {"tool": "run_action", "args": {"id": "orca_command:obj_type_part:orca"}},
    {"tool": "list_objects", "expect": {"/items/0/volumes/0/type": {"eq": "part"}, "/items/0/volumes/1/type": {"eq": "part"}}},
    {"tool": "select", "args": {"volumes": [[0, 1]]}},
    {"tool": "run_action", "args": {"id": "orca_command:obj_type_modifier:orca"}},
    // refused, changing nothing: the object's last solid part, and an object's row, which is not a part
    {"tool": "select", "args": {"volumes": [[0, 0]]}},
    {"tool": "run_action", "args": {"id": "orca_command:obj_type_modifier:orca"}, "optional": true},
    {"tool": "select", "args": {"objects": [0]}},
    {"tool": "run_action", "args": {"id": "orca_command:obj_type_part:orca"}, "optional": true},
    {"tool": "list_objects", "expect": {"/items/0/volumes/0/type": {"eq": "part"}, "/items/0/volumes/1/type": {"eq": "modifier"}}},
    // refused: an SVG part stays a part, a modifier or a negative part
    {"tool": "run_action", "args": {"id": "orca_command:add_primitive_svg:orca", "param": "${vars.svg}"}},
    {"tool": "wait", "args": {"for": "idle"}},
    {"tool": "ui_click", "args": {"target": {"gizmo": "SVG"}}},
    {"tool": "list_objects", "expect": {"/items/0/volumes/1/svg/path": {"contains": "star.svg"}, "/items/0/volumes/2/type": {"eq": "modifier"}}},
    {"tool": "select", "args": {"volumes": [[0, 1]]}},
    {"tool": "run_action", "args": {"id": "orca_command:obj_type_support_enforcer:orca"}, "optional": true},
    {"tool": "list_objects", "expect": {"/items/0/volumes/1/type": {"eq": "part"}}},
    // Rename an object and a part; refused: a name a file name cannot hold
    {"tool": "select", "args": {"objects": [0]}},
    {"tool": "run_action", "args": {"id": "orca_command:obj_rename:orca", "param": "base"}},
    {"tool": "select", "args": {"volumes": [[0, 2]]}},
    {"tool": "run_action", "args": {"id": "orca_command:obj_rename:orca", "param": "infill zone"}},
    {"tool": "run_action", "args": {"id": "orca_command:obj_rename:orca", "param": "a/b"}, "optional": true},
    {"tool": "list_objects", "expect": {"/items/0/name": {"eq": "base"}, "/items/0/volumes/2/name": {"eq": "infill zone"}}},
    // a number of instances in one undo step; refused: 0 and a word
    {"tool": "select", "args": {"none": true}},
    {"tool": "run_action", "args": {"id": "orca_command:add_primitive_cube:orca", "param": "20 20 20"}},
    {"tool": "select", "args": {"objects": [1]}},
    {"tool": "run_action", "args": {"id": "orca_command:obj_set_instances:orca", "param": "6"},
     "expect": {"/object": {"eq": 1}, "/instances": {"eq": 6}}},
    {"tool": "run_action", "args": {"id": "orca_command:undo:orca"}},
    {"tool": "list_objects", "expect": {"/items/1/instances/1": {"exists": false}}},
    {"tool": "select", "args": {"objects": [1]}},
    {"tool": "run_action", "args": {"id": "orca_command:obj_set_instances:orca", "param": "3"}},
    {"tool": "run_action", "args": {"id": "orca_command:obj_set_instances:orca", "param": "0"}, "optional": true},
    {"tool": "run_action", "args": {"id": "orca_command:obj_set_instances:orca", "param": "three"}, "optional": true},
    {"tool": "list_objects", "expect": {"/total": {"eq": 2}, "/items/1/instances/2": {"exists": true}, "/items/1/instances/3": {"exists": false}}},
    // every instance its own object (the whole object selected), then two of them assembled
    {"tool": "select", "args": {"objects": [1]}},
    {"tool": "run_action", "args": {"id": "orca_command:obj_instances_to_objects:orca"},
     "expect": {"/objects/0": {"eq": 1}, "/objects/2": {"eq": 3}}},
    {"tool": "list_objects", "expect": {"/total": {"eq": 4}, "/items/3/instances/1": {"exists": false}}},
    {"tool": "select", "args": {"objects": [1]}},
    {"tool": "run_action", "args": {"id": "orca_command:obj_instances_to_objects:orca"}, "optional": true},
    {"tool": "select", "args": {"objects": [2, 3]}},
    {"tool": "run_action", "args": {"id": "orca_command:obj_assemble:orca"}, "expect": {"/object": {"eq": 2}, "/name": {"eq": "Assembly"}}},
    {"tool": "list_objects", "expect": {"/total": {"eq": 3}, "/items/2/name": {"eq": "Assembly"}, "/items/2/volumes/1": {"exists": true}}},
    {"tool": "select", "args": {"objects": [0]}},
    {"tool": "run_action", "args": {"id": "orca_command:obj_assemble:orca"}, "optional": true},
    {"tool": "list_objects", "expect": {"/total": {"eq": 3}}},

    // ---- Order By: ascending, reversed when run again, and the reply says which ----
    {"tool": "new_project", "args": {"discard_changes": true}},
    {"tool": "run_action", "args": {"id": "orca_command:add_primitive_cube:orca", "param": "20 20 30"}},
    {"tool": "select", "args": {"none": true}},
    {"tool": "run_action", "args": {"id": "orca_command:add_primitive_cube:orca", "param": "20 20 10"}},
    {"tool": "select", "args": {"none": true}},
    {"tool": "run_action", "args": {"id": "orca_command:add_primitive_cube:orca", "param": "20 20 20"}},
    {"tool": "run_action", "args": {"id": "orca_command:obj_order_by_height:orca"},
     "expect": {"/descending": {"eq": false}, "/order/2/object": {"eq": 2}, "/order/2/plate": {"eq": 0}}},
    {"tool": "list_objects", "expect": {"/items/0/bbox/size/2": {"ge": 9.99, "le": 10.01}, "/items/2/bbox/size/2": {"ge": 29.99, "le": 30.01}}},
    {"tool": "run_action", "args": {"id": "orca_command:obj_order_by_height:orca"}, "expect": {"/descending": {"eq": true}}},
    {"tool": "list_objects", "expect": {"/items/0/bbox/size/2": {"ge": 29.99, "le": 30.01}}},
    // refused: an empty current plate, a param other than all; all orders every plate
    {"tool": "run_action", "args": {"id": "orca_command:plate_add:orca"}},
    {"tool": "run_action", "args": {"id": "orca_command:plate_goto:orca", "param": "1"}},
    {"tool": "run_action", "args": {"id": "orca_command:obj_order_by_size:orca"}, "optional": true},
    {"tool": "run_action", "args": {"id": "orca_command:obj_order_by_size:orca", "param": "every"}, "optional": true},
    {"tool": "list_objects", "expect": {"/items/0/bbox/size/2": {"ge": 29.99, "le": 30.01}}},
    {"tool": "run_action", "args": {"id": "orca_command:obj_order_by_size:orca", "param": "all"},
     "expect": {"/descending": {"eq": false}, "/order/0/plate": {"eq": 0}, "/order/3": {"exists": false}}},
    {"tool": "list_objects", "expect": {"/items/0/bbox/size/2": {"ge": 9.99, "le": 10.01}}},

    // ---- End to end: a block with a magnet pocket and a boss, sized on the bed, moved to a second
    // plate, six copies arranged apart there, each made its own object, one mirrored, two assembled,
    // all ordered by name, the plate filled with one of them, and the plate sliced ----
    {"tool": "new_project", "args": {"discard_changes": true}},
    {"tool": "run_action", "args": {"id": "orca_command:add_primitive_cube:orca", "param": "40 40 10"}},
    {"tool": "transform", "args": {"object": 0, "translate": [100, 100, 5], "mode": "absolute"}},
    {"tool": "add_part", "args": {"object": 0, "type": "negative", "shape": "cylinder", "size": [6.2, 3.2],
                                  "position": [100, 100, 1.6]}, "expect": {"/volume": {"eq": 1}}},
    // a boss on top; solid parts are listed before negative ones
    {"tool": "add_part", "args": {"object": 0, "type": "part", "shape": "cylinder", "size": [10, 5], "position": [100, 100, 12.5]},
     "expect": {"/volume": {"eq": 1}, "/volume_count": {"eq": 3}, "/volume_info/bbox/min/2": {"ge": 9.99, "le": 10.01}}},
    {"tool": "select", "args": {"volumes": [[0, 1]]}},
    {"tool": "run_action", "args": {"id": "orca_command:obj_rename:orca", "param": "boss"}},
    {"tool": "transform", "args": {"object": 0, "volume": 1, "translate": [5, 0, 0]},
     "expect": {"/volume_info/name": {"eq": "boss"}, "/volume_info/position/0": {"ge": 104.99, "le": 105.01}}},
    // 50 mm wide in proportion, so 1.25 x (10 + 5) mm tall, and still on the bed
    {"tool": "transform", "args": {"object": 0, "size": [50, null, null]}},
    {"tool": "list_objects", "expect": {"/items/0/bbox/size/0": {"ge": 49.99, "le": 50.01},
                                        "/items/0/bbox/size/2": {"ge": 18.74, "le": 18.76},
                                        "/items/0/bbox/min/2": {"ge": -0.001, "le": 0.001},
                                        "/items/0/volumes/2/type": {"eq": "negative"}}},
    {"tool": "run_action", "args": {"id": "orca_command:plate_add:orca"}},
    {"tool": "transform", "args": {"object": 0, "plate": 1}, "expect": {"/plate": {"eq": 1}}},
    // six copies, overlapping where Set Number of Instances puts them, spread out on plate 1 alone
    {"tool": "select", "args": {"objects": [0]}},
    {"tool": "run_action", "args": {"id": "orca_command:obj_set_instances:orca", "param": "6"}, "expect": {"/instances": {"eq": 6}}},
    {"tool": "arrange", "args": {"plates": 1, "spacing": 10, "rotate": false},
     "expect": {"/off_plate": {"empty": true}, "/settings/spacing": {"eq": 10}, "/plates": {"eq": 2}}},
    {"tool": "list_objects", "args": {"plate": 0}, "expect": {"/total": {"eq": 0}}},
    {"tool": "list_objects", "args": {"plate": 1}, "expect": {"/items/0/instances/5/plate": {"eq": 1}}},
    // every instance its own object (the whole object selected), each with the three parts
    {"tool": "select", "args": {"objects": [0]}},
    {"tool": "run_action", "args": {"id": "orca_command:obj_instances_to_objects:orca"}, "expect": {"/objects/5": {"eq": 5}}},
    {"tool": "list_objects", "expect": {"/total": {"eq": 6}, "/items/5/volumes/1/name": {"eq": "boss"},
                                        "/items/5/volumes/2/type": {"eq": "negative"}, "/items/5/instances/0/plate": {"eq": 1}}},
    {"tool": "select", "args": {"objects": [5]}},
    {"tool": "run_action", "args": {"id": "orca_command:obj_mirror_x:orca"}},
    {"tool": "list_objects", "expect": {"/items/5/instances/0/mirrored": {"eq": true}, "/items/4/instances/0/mirrored": {"eq": false}}},
    // two assembled into one object, which goes last; the mirrored one moves up to index 3
    {"tool": "select", "args": {"objects": [0, 1]}},
    {"tool": "run_action", "args": {"id": "orca_command:obj_assemble:orca"}, "expect": {"/object": {"eq": 4}, "/name": {"eq": "Assembly"}}},
    {"tool": "list_objects", "expect": {"/total": {"eq": 5}, "/items/4/volumes/5": {"exists": true},
                                        "/items/4/bbox/min/2": {"ge": -0.001, "le": 0.001},
                                        "/items/3/instances/0/mirrored": {"eq": true}}},
    {"tool": "run_action", "args": {"id": "orca_command:obj_order_by_name:orca", "param": "all"},
     "expect": {"/descending": {"eq": false}, "/order/0/name": {"eq": "Assembly"}, "/order/4/plate": {"eq": 1}}},
    {"tool": "arrange", "args": {"fill": 1}, "expect": {"/added": {"gt": 0}, "/plate": {"eq": 1}, "/off_plate": {"empty": true}}},
    {"tool": "slice", "args": {"plates": 1}, "expect": {"/plates/0/outcome": {"eq": "ok"}}},
    {"tool": "set_view", "args": {"tab": "prepare"}},
    {"tool": "screenshot","args": {"target": "canvas", "save_path": "${out_dir}/scene.png", "overwrite": true, "include_image": false}}
  ]
}
