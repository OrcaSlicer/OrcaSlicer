// Records what the STL export, project_export with format stl and a path, does: with no objects and with two,
// each case exported once, to a file named for it. After each it reads whether the file is there (an stl export
// to the same path with a plate the project lacks refuses with "exists" when it is, with the plate when not; for
// the file written with no objects, once the objects are added), the project and the undo snapshots taken since
// the last read (fixtures/ops_undo.py), and last imports each file into an empty project to show what it holds.
// Every call it records is optional. Run it into a fresh --out directory (an export without overwrite refuses the
// file of an earlier run):
//   tools/mcp/orca_mcp.py run-replay tools/mcp/tests/ops_export_stl.json --out <new dir>
{
  "orca_replay_version": "0.2.0",
  "name": "ops export_stl",
  "vars": {"undo": "${replay_dir}/fixtures/ops_undo.py"},
  "steps": [
    {"tool": "app_wait", "args": {"for": "ready"}},
    {"tool": "project_new", "args": {"discard_changes": true, "preset_changes": "discard"}},
    {"tool": "view_set", "args": {"tab": "prepare"}},
    {"tool": "app_wait", "args": {"for": "idle"}},
    {"tool": "script_run", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"}},

    // ---- No objects ----
    {"tool": "project_export", "args": {"format": "stl", "path": "${out_dir}/empty.stl"}, "optional": true},
    {"tool": "app_state"},
    {"tool": "script_run", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"}},

    // ---- With two objects ----
    {"tool": "object_add_primitive", "args": {"shape": "cube", "size": [20, 20, 20]}},
    {"tool": "object_select", "args": {"none": true}},
    {"tool": "object_add_primitive", "args": {"shape": "cylinder", "size": [20, 10]}},
    {"tool": "object_arrange", "args": {"plates": "all"}},
    {"tool": "app_wait", "args": {"for": "idle"}},
    {"tool": "project_export", "args": {"format": "stl", "path": "${out_dir}/empty.stl", "plates": 999}, "optional": true},
    {"tool": "script_run", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"}},
    {"tool": "project_export", "args": {"format": "stl", "path": "${out_dir}/two_objects.stl"}, "optional": true},
    {"tool": "project_export", "args": {"format": "stl", "path": "${out_dir}/two_objects.stl", "plates": 999}, "optional": true},
    {"tool": "app_state"},
    {"tool": "script_run", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"}},

    // ---- What the files hold ----
    {"tool": "project_new", "args": {"discard_changes": true}},
    {"tool": "project_import", "args": {"paths": ["${out_dir}/empty.stl"]}, "await": false, "save_as": "import_empty", "optional": true},
    {"tool": "app_state"},
    {"tool": "dialog_answer", "args": {"button": "ok"}, "optional": true},
    {"tool": "dialog_answer", "args": {"button": "ok"}, "optional": true},
    {"tool": "app_wait", "args": {"for": "job", "job": "${jobs.import_empty}"}, "optional": true},
    {"tool": "project_import", "args": {"paths": ["${out_dir}/two_objects.stl"]}, "optional": true},
    {"tool": "object_list"},

    {"tool": "project_new", "args": {"discard_changes": true}}
  ]
}
