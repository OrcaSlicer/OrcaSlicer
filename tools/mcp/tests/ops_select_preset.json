    {"tool": "run_script", "args": {"filename": "${replay_dir}/fixtures/ops_presets.py", "code": "import ops_presets\nresult = ops_presets.arrange_presets(args)", "args": {"printer": "Bambu Lab X1 Carbon 0.4 nozzle", "process": "0.20mm Standard @BBL X1C"}}, "expect": {"/result/dialogs": {"empty": true}, "/result/printer_tab": {"regex": "^Bambu Lab X1 Carbon 0.4 nozzle"}, "/result/process_tab": {"regex": "^0.20mm Standard @BBL X1C"}}},
