// Records the selection of a printer or process preset, the one its tab then edits, through the select_preset
// tool and the plugin API's orca.host.preset.process / .printer begin_update(name) run from run_script: an
// ordinary selection, unsaved changes (the tool's preset_changes values and none, the prompt answered each way
// for both routes and read while it is open), the preset already edited, a hidden printer (each route shows
// one) and the refusals. Each case starts from fixtures/ops_presets.py's arrange_presets()
// and reads what the call left once queued events have settled (the preset each tab edits, slots, dialogs, undo
// snapshots). Refused calls are optional. Run it on a freshly launched app (a hidden preset stays shown until a
// restart) with
//   tools/mcp/orca_mcp.py run-replay tools/mcp/tests/ops_select_preset.json --out <dir>
{
  "orca_replay": 1,
  "name": "ops select_preset",
  "steps": [
    {"tool": "wait", "args": {"for": "ready"}},
    {"tool": "new_project", "args": {"discard_changes": true, "preset_changes": "discard"}},
    {"tool": "set_window", "args": {"size": [1920, 1040]}},
    {"tool": "set_view", "args": {"tab": "prepare"}},
    // Simple mode, as on a fresh datadir: the unsaved-changes prompt lists the settings the mode shows.
    {"tool": "run_action", "args": {"id": "orca_command:mode_simple:orca"}},
    // One slot first, so the presets below are shown and selected on the harness's default printer.
    {"tool": "run_action", "args": {"id": "orca_command:filament_delete:orca"}, "optional": true},
    {"tool": "run_action", "args": {"id": "orca_command:filament_delete:orca"}, "optional": true},
    {"tool": "run_action", "args": {"id": "orca_command:filament_delete:orca"}, "optional": true},
    {"tool": "run_action", "args": {"id": "orca_command:filament_delete:orca"}, "optional": true},
    {"tool": "select_preset", "args": {"type": "printer", "name": "Bambu Lab X1 Carbon 0.4 nozzle", "preset_changes": "discard"}},
    {"tool": "select_preset", "args": {"type": "process", "name": "0.20mm Standard @BBL X1C", "preset_changes": "discard"}},
    {"tool": "select_preset", "args": {"type": "filament", "name": "Bambu PLA Basic", "filament_slot": 1, "preset_changes": "discard"}},
    // The filaments the cases pick, hidden on a fresh datadir, are shown in every selector (until the app
    // restarts) by selecting each once with the tool. FilAr PLA Blanco Calido has a default colour
    // (#FFF8E7); the Bambu ones have none.
    {"tool": "select_preset", "args": {"type": "filament", "name": "FilAr PLA Blanco Calido", "filament_slot": 1}},
    {"tool": "select_preset", "args": {"type": "filament", "name": "Bambu PLA Matte", "filament_slot": 1}},
    {"tool": "select_preset", "args": {"type": "filament", "name": "Bambu Support For PLA", "filament_slot": 1}},
    {"tool": "select_preset", "args": {"type": "filament", "name": "Bambu Support for ABS", "filament_slot": 1}},
    {"tool": "select_preset", "args": {"type": "filament", "name": "Bambu PLA Basic", "filament_slot": 1}},
    {"tool": "get_app_state", "expect": {"/presets/filaments/0": {"exists": true}, "/presets/filaments/1": {"exists": false}}},

