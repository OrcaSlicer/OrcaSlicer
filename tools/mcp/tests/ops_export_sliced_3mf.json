// Records what the sliced-file export, project_export with format sliced_3mf and a path, does for the current
// plate, a plate index and all plates: with no objects, on a plate not sliced, sliced, and with one plate of two
// sliced, from either plate. Each case exports once, to a file named for it. After each it reads whether the file
// is there (an stl export to the same path with a plate the project lacks refuses with "exists" when it is, with
// the plate when not), the plates, the project and the undo snapshots taken since the last read
// (fixtures/ops_undo.py). Every call it records is optional. Run it into a fresh --out directory (an export
// without overwrite refuses the file of an earlier run):
//   tools/mcp/orca_mcp.py run-replay tools/mcp/tests/ops_export_sliced_3mf.json --out <new dir>
{
  "orca_replay_version": "0.2.0",
  "name": "ops export_sliced_3mf",
  "vars": {"undo": "${replay_dir}/fixtures/ops_undo.py"},
  "steps": [
    {"tool": "app_wait", "args": {"for": "ready"}},
    {"tool": "project_new", "args": {"discard_changes": true, "preset_changes": "discard"}},
    {"tool": "view_set", "args": {"tab": "prepare"}},
    {"tool": "app_wait", "args": {"for": "idle"}},
    {"tool": "script_run", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"}},

    // ---- No objects ----
    {"tool": "project_export", "args": {"format": "sliced_3mf", "path": "${out_dir}/empty.gcode.3mf"}, "optional": true},
    {"tool": "project_export", "args": {"format": "sliced_3mf", "plates": "all", "path": "${out_dir}/empty_all.gcode.3mf"}, "optional": true},
    {"tool": "app_state"},

    // ---- A plate that is not sliced ----
    {"tool": "object_add_primitive", "args": {"shape": "cube", "size": [20, 20, 20]}},
    {"tool": "app_wait", "args": {"for": "idle"}},
    {"tool": "script_run", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"}},
    {"tool": "project_export", "args": {"format": "sliced_3mf", "path": "${out_dir}/unsliced.gcode.3mf"}, "optional": true},
    {"tool": "project_export", "args": {"format": "sliced_3mf", "plates": "all", "path": "${out_dir}/unsliced_all.gcode.3mf"}, "optional": true},
    {"tool": "app_state"},
    {"tool": "project_export", "args": {"format": "stl", "path": "${out_dir}/empty.gcode.3mf", "plates": 999}, "optional": true},
    {"tool": "project_export", "args": {"format": "stl", "path": "${out_dir}/empty_all.gcode.3mf", "plates": 999}, "optional": true},
    {"tool": "project_export", "args": {"format": "stl", "path": "${out_dir}/unsliced.gcode.3mf", "plates": 999}, "optional": true},
    {"tool": "project_export", "args": {"format": "stl", "path": "${out_dir}/unsliced_all.gcode.3mf", "plates": 999}, "optional": true},
    {"tool": "script_run", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"}},

    // ---- Sliced ----
    {"tool": "plate_slice", "expect": {"/plates/0/outcome": {"eq": "ok"}}},
    {"tool": "app_wait", "args": {"for": "idle"}},
    {"tool": "script_run", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"}},
    {"tool": "project_export", "args": {"format": "sliced_3mf", "path": "${out_dir}/sliced.gcode.3mf"}, "optional": true},
    {"tool": "project_export", "args": {"format": "stl", "path": "${out_dir}/sliced.gcode.3mf", "plates": 999}, "optional": true},
    {"tool": "project_export", "args": {"format": "sliced_3mf", "plates": "all", "path": "${out_dir}/sliced_all.gcode.3mf"}, "optional": true},
    {"tool": "project_export", "args": {"format": "stl", "path": "${out_dir}/sliced_all.gcode.3mf", "plates": 999}, "optional": true},
    {"tool": "plate_list"},
    {"tool": "app_state"},
    {"tool": "script_run", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"}},

    // ---- One plate of two sliced: plate 0 sliced, plate 1 not ----
    {"tool": "action_run", "args": {"id": "orca_command:plate_add:orca"}},
    {"tool": "plate_select", "args": {"plate": 1}},
    {"tool": "object_select", "args": {"none": true}},
    {"tool": "object_add_primitive", "args": {"shape": "cube", "size": [20, 20, 20]}},
    {"tool": "app_wait", "args": {"for": "idle"}},
    {"tool": "plate_slice", "args": {"plates": 0}, "expect": {"/plates/0/outcome": {"eq": "ok"}}},
    {"tool": "app_wait", "args": {"for": "idle"}},
    {"tool": "plate_list", "expect": {"/total": {"eq": 2}, "/items/0/sliced": {"eq": true}, "/items/1/sliced": {"eq": false}}},
    {"tool": "script_run", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"}},
    // From plate 0: the current plate, all plates, and each plate by its index.
    {"tool": "plate_select", "args": {"plate": 0}},
    {"tool": "project_export", "args": {"format": "sliced_3mf", "path": "${out_dir}/half_current_0.gcode.3mf"}, "optional": true},
    {"tool": "project_export", "args": {"format": "stl", "path": "${out_dir}/half_current_0.gcode.3mf", "plates": 999}, "optional": true},
    {"tool": "project_export", "args": {"format": "sliced_3mf", "plates": "all", "path": "${out_dir}/half_all_from_0.gcode.3mf"}, "optional": true},
    {"tool": "project_export", "args": {"format": "stl", "path": "${out_dir}/half_all_from_0.gcode.3mf", "plates": 999}, "optional": true},
    {"tool": "project_export", "args": {"format": "sliced_3mf", "plates": 0, "path": "${out_dir}/half_plate_0.gcode.3mf"}, "optional": true},
    {"tool": "project_export", "args": {"format": "stl", "path": "${out_dir}/half_plate_0.gcode.3mf", "plates": 999}, "optional": true},
    {"tool": "project_export", "args": {"format": "sliced_3mf", "plates": 1, "path": "${out_dir}/half_plate_1.gcode.3mf"}, "optional": true},
    {"tool": "project_export", "args": {"format": "stl", "path": "${out_dir}/half_plate_1.gcode.3mf", "plates": 999}, "optional": true},
    {"tool": "plate_list"},
    // From plate 1: the current plate and all plates.
    {"tool": "plate_select", "args": {"plate": 1}},
    {"tool": "project_export", "args": {"format": "sliced_3mf", "path": "${out_dir}/half_current_1.gcode.3mf"}, "optional": true},
    {"tool": "project_export", "args": {"format": "stl", "path": "${out_dir}/half_current_1.gcode.3mf", "plates": 999}, "optional": true},
    {"tool": "project_export", "args": {"format": "sliced_3mf", "plates": "all", "path": "${out_dir}/half_all_from_1.gcode.3mf"}, "optional": true},
    {"tool": "project_export", "args": {"format": "stl", "path": "${out_dir}/half_all_from_1.gcode.3mf", "plates": 999}, "optional": true},
    {"tool": "plate_list"},
    {"tool": "app_state"},
    {"tool": "script_run", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"}},

    {"tool": "project_new", "args": {"discard_changes": true}}
  ]
}
