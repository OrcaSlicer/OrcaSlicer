// Records how a plate is locked through its three routes: the plate_toggle_lock tile run with action_run (the
// current plate), plate_lock with locked, and a click on the plate's lock icon ({plate_icon: "lock", plate}).
// Each is run twice on plate 0, then on plate 1 while plate 0 is current; plate_lock also with a plate the
// project lacks. After each it reads the lock state and the current plate (plate_list) and the undo
// snapshots taken since the last read (fixtures/ops_undo.py), and last it locks through each route and runs undo
// once, to show that the lock is one undo step. Every call it records is optional. Run it with
//   tools/mcp/orca_mcp.py run-replay tools/mcp/tests/ops_set_plate_locked.json --out <dir>
{
  "orca_replay_version": "0.2.0",
  "name": "ops set_plate_locked",
  "vars": {"undo": "${replay_dir}/fixtures/ops_undo.py"},
  "steps": [
    {"tool": "app_wait", "args": {"for": "ready"}},
    {"tool": "project_new", "args": {"discard_changes": true, "preset_changes": "discard"}},
    {"tool": "window_set", "args": {"size": [1600, 900]}},
    {"tool": "view_set", "args": {"tab": "prepare"}},
    {"tool": "object_add_primitive", "args": {"shape": "cube", "size": [20, 20, 20]}},
    {"tool": "action_run", "args": {"id": "orca_command:plate_add:orca"}},
    {"tool": "plate_select", "args": {"plate": 0}},
    {"tool": "app_wait", "args": {"for": "idle"}},
    {"tool": "plate_list", "expect": {"/total": {"eq": 2}, "/items/0/current": {"eq": true}}},
    {"tool": "script_run", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"}},

    // ---- The tile, twice on plate 0 ----
    {"tool": "action_run", "args": {"id": "orca_command:plate_toggle_lock:orca"}, "optional": true},
    {"tool": "plate_list"},
    {"tool": "script_run", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"}},
    {"tool": "action_run", "args": {"id": "orca_command:plate_toggle_lock:orca"}, "optional": true},
    {"tool": "plate_list"},
    {"tool": "script_run", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"}},

    // ---- plate_lock, locked true twice, then false, then a plate the project lacks ----
    {"tool": "plate_lock", "args": {"plate": 0, "locked": true}, "optional": true},
    {"tool": "plate_list"},
    {"tool": "script_run", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"}},
    {"tool": "plate_lock", "args": {"plate": 0, "locked": true}, "optional": true},
    {"tool": "plate_list"},
    {"tool": "script_run", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"}},
    {"tool": "plate_lock", "args": {"plate": 0, "locked": false}, "optional": true},
    {"tool": "plate_list"},
    {"tool": "script_run", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"}},
    {"tool": "plate_lock", "args": {"plate": 5, "locked": true}, "optional": true},
    {"tool": "plate_list"},

    // ---- The lock icon, twice on plate 0 ----
    {"tool": "widget_click", "args": {"target": {"plate_icon": "lock", "plate": 0}}, "optional": true},
    {"tool": "plate_list"},
    {"tool": "script_run", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"}},
    {"tool": "widget_click", "args": {"target": {"plate_icon": "lock", "plate": 0}}, "optional": true},
    {"tool": "plate_list"},
    {"tool": "script_run", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"}},

    // ---- Plate 1 while plate 0 is current: plate_lock and the icon (the tile has no plate) ----
    {"tool": "plate_lock", "args": {"plate": 1, "locked": true}, "optional": true},
    {"tool": "plate_list"},
    {"tool": "script_run", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"}},
    {"tool": "plate_select", "args": {"plate": 0}},
    {"tool": "widget_click", "args": {"target": {"plate_icon": "lock", "plate": 1}}, "optional": true},
    {"tool": "plate_list"},
    {"tool": "script_run", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"}},

    // ---- Undo after each route's lock ----
    {"tool": "plate_select", "args": {"plate": 0}},
    {"tool": "action_run", "args": {"id": "orca_command:plate_toggle_lock:orca"}, "optional": true},
    {"tool": "plate_list"},
    {"tool": "action_run", "args": {"id": "orca_command:undo:orca"}},
    {"tool": "plate_list"},
    {"tool": "plate_lock", "args": {"plate": 0, "locked": true}, "optional": true},
    {"tool": "plate_list"},
    {"tool": "action_run", "args": {"id": "orca_command:undo:orca"}},
    {"tool": "plate_list"},
    {"tool": "widget_click", "args": {"target": {"plate_icon": "lock", "plate": 0}}, "optional": true},
    {"tool": "plate_list"},
    {"tool": "action_run", "args": {"id": "orca_command:undo:orca"}},
    {"tool": "plate_list"},
    {"tool": "script_run", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"}},

    {"tool": "project_new", "args": {"discard_changes": true}}
  ]
}
