// view_set outside the Design tab, each state read back from its reply and from app_state's view: the sidebar
// collapsed and expanded, set to a width and to the default one; in Prepare each display switch turned on and off, the
// projection and the section view; in the Preview of a sliced cube the legend folded and the G-code window hidden and
// shown again. Then a cube placed by numbers in the middle of plate 1, from plate_list's origin and size, which
// object_list lists on plate 1, and app_state's account, network plug-in and configuration folder. Run on a live app:
//   python3 tools/mcp/orca_mcp.py run-replay tools/mcp/tests/view_switches.json --out <dir>
{
  "orca_replay_version": "0.2.0",
  "name": "view switches",
  "vars": {"cube": "${replay_dir}/../../../resources/handy_models/OrcaCube_v2.drc"},
  "steps": [
    {"tool": "app_wait", "args": {"for": "ready"}},
    {"tool": "project_new", "args": {"discard_changes": true}},
    {"tool": "window_set", "args": {"size": [1600, 900]}},
    {"tool": "view_set", "args": {"tab": "prepare"}},

    // ---- The sidebar: collapsed and expanded, then a width wider than the default, then the default again, which a
    // fresh configuration folder starts at ----
    {"tool": "view_set", "args": {"sidebar_collapsed": true}, "expect": {"/sidebar_collapsed": {"eq": true}}},
    {"tool": "app_state", "expect": {"/view/sidebar_collapsed": {"eq": true}}},
    {"tool": "view_set", "args": {"sidebar_collapsed": false}, "expect": {"/sidebar_collapsed": {"eq": false}}},
    {"tool": "app_state", "expect": {"/view/sidebar_collapsed": {"eq": false}}},
    {"tool": "script_run",
     "args": {"code": "import orca\ncall = orca.host.tools.call\nstart = call('app_state', {})['view']['sidebar_width']\nwide = start + 150\nset_wide = call('view_set', {'sidebar_width': wide})['sidebar_width']\nread_wide = call('app_state', {})['view']['sidebar_width']\nset_default = call('view_set', {'sidebar_width': 'default'})['sidebar_width']\nread_default = call('app_state', {})['view']['sidebar_width']\nresult = {'start': start, 'wide': set_wide == wide and read_wide == wide, 'default': set_default == start and read_default == start, 'widths': [start, set_wide, read_wide, set_default, read_default]}"},
     "expect": {"/result/start": {"gt": 100}, "/result/wide": {"eq": true}, "/result/default": {"eq": true}}},

    // ---- In Prepare each display switch on, then off ----
    {"tool": "view_set", "args": {"labels": true}, "expect": {"/labels": {"eq": true}}},
    {"tool": "app_state", "expect": {"/view/labels": {"eq": true}}},
    {"tool": "view_set", "args": {"labels": false}, "expect": {"/labels": {"eq": false}}},
    {"tool": "app_state", "expect": {"/view/labels": {"eq": false}}},
    {"tool": "view_set", "args": {"overhangs": true}, "expect": {"/overhangs": {"eq": true}}},
    {"tool": "app_state", "expect": {"/view/overhangs": {"eq": true}}},
    {"tool": "view_set", "args": {"overhangs": false}, "expect": {"/overhangs": {"eq": false}}},
    {"tool": "app_state", "expect": {"/view/overhangs": {"eq": false}}},
    {"tool": "view_set", "args": {"outline": true}, "expect": {"/outline": {"eq": true}}},
    {"tool": "app_state", "expect": {"/view/outline": {"eq": true}}},
    {"tool": "view_set", "args": {"outline": false}, "expect": {"/outline": {"eq": false}}},
    {"tool": "app_state", "expect": {"/view/outline": {"eq": false}}},
    {"tool": "view_set", "args": {"wireframe": true}, "expect": {"/wireframe": {"eq": true}}},
    {"tool": "app_state", "expect": {"/view/wireframe": {"eq": true}}},
    {"tool": "view_set", "args": {"wireframe": false}, "expect": {"/wireframe": {"eq": false}}},
    {"tool": "app_state", "expect": {"/view/wireframe": {"eq": false}}},
    {"tool": "view_set", "args": {"gridlines": true}, "expect": {"/gridlines": {"eq": true}}},
    {"tool": "app_state", "expect": {"/view/gridlines": {"eq": true}}},
    {"tool": "view_set", "args": {"gridlines": false}, "expect": {"/gridlines": {"eq": false}}},
    {"tool": "app_state", "expect": {"/view/gridlines": {"eq": false}}},
    {"tool": "view_set", "args": {"axes": true}, "expect": {"/axes": {"eq": true}}},
    {"tool": "app_state", "expect": {"/view/axes": {"eq": true}}},
    {"tool": "view_set", "args": {"axes": false}, "expect": {"/axes": {"eq": false}}},
    {"tool": "app_state", "expect": {"/view/axes": {"eq": false}}},
    {"tool": "view_set", "args": {"navigator": true}, "expect": {"/navigator": {"eq": true}}},
    {"tool": "app_state", "expect": {"/view/navigator": {"eq": true}}},
    {"tool": "view_set", "args": {"navigator": false}, "expect": {"/navigator": {"eq": false}}},
    {"tool": "app_state", "expect": {"/view/navigator": {"eq": false}}},
    // Several at once, the gridlines, axes and navigator back on.
    {"tool": "view_set", "args": {"gridlines": true, "axes": true, "navigator": true},
     "expect": {"/gridlines": {"eq": true}, "/axes": {"eq": true}, "/navigator": {"eq": true}}},
    {"tool": "app_state", "expect": {"/view/gridlines": {"eq": true}, "/view/axes": {"eq": true}, "/view/navigator": {"eq": true}}},

    // ---- The projection, orthographic and back ----
    {"tool": "view_set", "args": {"projection": "orthographic"}, "expect": {"/projection": {"eq": "orthographic"}}},
    {"tool": "app_state", "expect": {"/view/projection": {"eq": "orthographic"}, "/camera/type": {"eq": "ortho"}}},
    {"tool": "view_set", "args": {"projection": "perspective"}, "expect": {"/projection": {"eq": "perspective"}}},
    {"tool": "app_state", "expect": {"/view/projection": {"eq": "perspective"}}},

    // ---- The section view of Prepare, on and off ----
    {"tool": "view_set", "args": {"section": {"on": true}}, "expect": {"/section/on": {"eq": true}}},
    {"tool": "app_state", "expect": {"/view/section/on": {"eq": true}, "/tab": {"eq": "prepare"}}},
    {"tool": "view_set", "args": {"section": {"on": false}}, "expect": {"/section/on": {"eq": false}}},
    {"tool": "app_state", "expect": {"/view/section/on": {"eq": false}}},

    // ---- In the Preview of a sliced cube: the legend folded and unfolded, the G-code window hidden and shown ----
    {"tool": "project_import", "args": {"paths": ["${vars.cube}"]}, "expect": {"/added": {"eq": 1}}},
    {"tool": "plate_slice", "args": {"preview": true}, "expect": {"/status": {"eq": "done"}, "/plates/0/outcome": {"eq": "ok"}}},
    {"tool": "view_set", "args": {"legend_collapsed": true}, "expect": {"/legend_collapsed": {"eq": true}}},
    {"tool": "app_state", "expect": {"/view/legend_collapsed": {"eq": true}, "/tab": {"eq": "preview"}}},
    {"tool": "view_set", "args": {"legend_collapsed": false}, "expect": {"/legend_collapsed": {"eq": false}}},
    {"tool": "app_state", "expect": {"/view/legend_collapsed": {"eq": false}}},
    {"tool": "view_set", "args": {"gcode_window": false}, "expect": {"/gcode_window": {"eq": false}}},
    {"tool": "app_state", "expect": {"/view/gcode_window": {"eq": false}}},
    {"tool": "view_set", "args": {"gcode_window": true}, "expect": {"/gcode_window": {"eq": true}}},
    {"tool": "app_state", "expect": {"/view/gcode_window": {"eq": true}}},
    // Picking a view type unfolds the legend, which a fold asked for in the same call keeps folded.
    {"tool": "view_set", "args": {"view_type": "speed", "legend_collapsed": true}, "expect": {"/legend_collapsed": {"eq": true}}},
    {"tool": "app_state", "expect": {"/view/legend_collapsed": {"eq": true}}},

    // ---- A cube placed by numbers in the middle of plate 1 stands on plate 1 ----
    {"tool": "view_set", "args": {"tab": "prepare"}},
    {"tool": "plate_add"},
    {"tool": "plate_list", "expect": {"/items/1/origin/0": {"gt": 0}, "/items/1/size/0": {"gt": 0}, "/items/1/objects": {"eq": 0}}},
    {"tool": "script_run",
     "args": {"code": "import orca\ncall = orca.host.tools.call\nplate = call('plate_list', {})['items'][1]\nx = plate['origin'][0] + plate['size'][0] / 2\ny = plate['origin'][1] + plate['size'][1] / 2\nadded = call('object_add_primitive', {'shape': 'cube', 'size': [20, 20, 20], 'position': [x, y, 0], 'name': 'middle of plate 1'})\nresult = {'x': x, 'y': y, 'added': added}"}},
    {"tool": "object_list", "expect": {"/plates/1/objects/0/name": {"eq": "middle of plate 1"},
                                       "/plates/1/objects/1": {"exists": false},
                                       "/plates/0/objects/0/name": {"ne": "middle of plate 1"}}},
    {"tool": "plate_list", "expect": {"/items/1/objects": {"eq": 1}, "/items/0/objects": {"eq": 1}}},

    // ---- The account, the network plug-in and the configuration folder, which is the scratch one the app runs on:
    // where its log is, and not a person's ----
    {"tool": "app_state", "expect": {"/account/signed_in": {"eq": false}, "/account/bambu_signed_in": {"eq": false},
                                     "/network_plugin/installed": {"exists": true}, "/network_plugin/loaded": {"exists": true},
                                     "/network_plugin/version": {"exists": true}, "/network_plugin/error": {"exists": true}}},
    {"tool": "script_run",
     "args": {"code": "import os\nimport orca\ncall = orca.host.tools.call\nfolder = call('app_state', {})['config_folder']\nlog = call('app_log', {'lines': 1})['file']\nsame = lambda a, b: os.path.normcase(os.path.normpath(a)) == os.path.normcase(os.path.normpath(b))\npersonal = os.path.join(os.environ.get('APPDATA', os.path.expanduser('~')), 'OrcaSlicer')\nresult = {'folder': folder, 'holds_the_log': same(os.path.dirname(os.path.dirname(log)), folder), 'personal': same(folder, personal)}"},
     "expect": {"/result/holds_the_log": {"eq": true}, "/result/personal": {"eq": false}}}
  ]
}
