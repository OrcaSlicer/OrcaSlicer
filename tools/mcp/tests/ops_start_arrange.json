// Records what an arrange does, object_arrange {} (Auto-Arrange's arguments; action_run of the obj_arrange action runs
// the same function) and object_arrange with one plate by index: with no objects, with two cubes on one spot, in the
// assemble view, with the Move gizmo open, and with the plate locked. After each it reads the objects' offsets,
// the tab, canvas and gizmo, and the undo snapshots taken since the last read (fixtures/ops_undo.py), and once
// runs undo to show what the arrange's step takes back. A person's pick of Auto-Arrange is checked by
// test_person_forms.py. An arrange running while another call comes needs two clients. Every call it records is
// optional. Run it with
//   tools/mcp/orca_mcp.py run-replay tools/mcp/tests/ops_start_arrange.json --out <dir>
{
  "orca_replay_version": "0.2.0",
  "name": "ops start_arrange",
  "vars": {"undo": "${replay_dir}/fixtures/ops_undo.py"},
  "steps": [
    {"tool": "app_wait", "args": {"for": "ready"}},
    {"tool": "project_new", "args": {"discard_changes": true, "preset_changes": "discard"}},
    {"tool": "window_set", "args": {"size": [1600, 900]}},
    {"tool": "view_set", "args": {"tab": "prepare"}},
    {"tool": "app_wait", "args": {"for": "idle"}},
    {"tool": "script_run", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"}},

    // ---- No objects ----
    {"tool": "object_arrange", "args": {}, "optional": true},
    {"tool": "object_arrange", "args": {"plates": 0}, "optional": true},
    {"tool": "script_run", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"}},

    // ---- Two cubes on one spot: every plate, undone, then one plate ----
    {"tool": "object_add_primitive", "args": {"shape": "cube", "size": [20, 20, 20]}},
    {"tool": "object_select", "args": {"none": true}},
    {"tool": "object_add_primitive", "args": {"shape": "cube", "size": [20, 20, 20]}},
    {"tool": "app_wait", "args": {"for": "idle"}},
    {"tool": "object_list", "expect": {"/total": {"eq": 2}, "/plates/0/objects/0/instances/0/offset/0": {"eq": 128.0},
                                       "/plates/0/objects/1/instances/0/offset/0": {"eq": 128.0}}},
    {"tool": "view_set", "args": {"tab": "preview"}},
    {"tool": "script_run", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"}},
    {"tool": "object_arrange", "args": {}, "optional": true},
    {"tool": "object_list"},
    {"tool": "app_state"},
    {"tool": "script_run", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"}},
    {"tool": "action_run", "args": {"id": "orca_command:undo:orca"}},
    {"tool": "object_list"},
    {"tool": "object_arrange", "args": {"plates": 0}, "optional": true},
    {"tool": "object_list"},
    {"tool": "script_run", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"}},

    // ---- In the assemble view ----
    {"tool": "view_set", "args": {"canvas": "assemble"}},
    {"tool": "app_state"},
    {"tool": "object_arrange", "args": {}, "optional": true},
    {"tool": "app_state"},
    {"tool": "view_set", "args": {"canvas": "3d"}},
    {"tool": "script_run", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"}},

    // ---- With the Move gizmo open ----
    {"tool": "object_select", "args": {"objects": [0]}},
    {"tool": "widget_click", "args": {"target": {"gizmo": "Move"}}, "expect": {"/active": {"eq": true}}},
    {"tool": "object_arrange", "args": {}, "optional": true},
    {"tool": "app_state"},
    {"tool": "script_run", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"}},
    {"tool": "view_set", "args": {"tab": "prepare"}},
    {"tool": "app_state"},
    {"tool": "widget_click", "args": {"target": {"gizmo": "Move"}}, "optional": true},
    {"tool": "app_state"},

    // ---- With the plate locked (the cubes back on one spot) ----
    {"tool": "object_transform", "args": {"object": 0, "translate": [128, 128, 10], "mode": "absolute"}},
    {"tool": "object_transform", "args": {"object": 1, "translate": [128, 128, 10], "mode": "absolute"}},
    {"tool": "action_run", "args": {"id": "orca_command:plate_toggle_lock:orca"}},
    {"tool": "plate_list", "expect": {"/items/0/locked": {"eq": true}}},
    {"tool": "script_run", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"}},
    {"tool": "object_arrange", "args": {}, "optional": true},
    {"tool": "object_list"},
    {"tool": "object_arrange", "args": {"plates": 0}, "optional": true},
    {"tool": "object_list"},
    {"tool": "script_run", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"}},
    {"tool": "action_run", "args": {"id": "orca_command:plate_toggle_lock:orca"}},

    {"tool": "project_new", "args": {"discard_changes": true}}
  ]
}
