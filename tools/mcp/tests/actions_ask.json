// A call with exactly an action's arguments does what a person's pick of the action does, and an action whose menu item
// and tool do the same thing runs the tool's function: calibration_generate_test with test alone asks in the test's
// dialog, and with silent runs with its defaults; View: Top turns the Design tab's camera; Go to tab and Go to layer
// take their value through action_run; plate_slice {preview: true} and Slice and Preview slice and show the Preview
// tab; Deselect All clears the selection of the view shown. Run on a live app with the Design tab
// (orca_mcp.py launch --cad):
//   python3 tools/mcp/orca_mcp.py run-replay tools/mcp/tests/actions_ask.json --out <dir>
{
  "orca_replay_version": "0.2.0",
  "name": "actions that ask",
  "vars": {"cube": "${replay_dir}/../../../resources/handy_models/OrcaCube_v2.drc"},
  "steps": [
    {"tool": "app_wait", "args": {"for": "ready"}},
    {"tool": "dialog_auto_answer", "args": {"rules": [{"match": "restore", "button": "no"}]}},
    {"tool": "project_new", "args": {"discard_changes": true, "preset_changes": "discard"}},

    // ---- calibration_generate_test: test alone asks in the test's dialog; silent runs with its defaults ----
    {"tool": "calibration_generate_test", "args": {"test": "temperature"}, "await": false, "save_as": "asked",
     "expect": {"/status": {"eq": "blocked_by_dialog"}}},
    {"tool": "app_wait", "args": {"for": "dialog"}},
    {"tool": "dialog_answer", "args": {"dialog": {"title": "Temperature calibration"}, "button": "cancel"}},
    {"tool": "app_wait", "args": {"for": "job", "job": "${jobs.asked}"}},
    {"tool": "calibration_generate_test", "args": {"test": "temperature", "silent": true, "discard_changes": true, "preset_changes": "discard"},
     "expect": {"/test": {"eq": "temperature"}}},
    {"tool": "object_list", "expect": {"/total": {"ge": 1}, "/plates/0/objects/0/name": {"exists": true}}},

    // ---- View: Top on the Design tab is view_set's own function, which turns the Design view's camera ----
    {"tool": "project_new", "args": {"discard_changes": true, "preset_changes": "discard"}},
    {"tool": "project_import", "args": {"paths": ["${vars.cube}"]}, "expect": {"/added": {"eq": 1}}},
    {"tool": "object_transform", "args": {"object": 0, "size": [20, 20, 20]}},
    {"tool": "view_set", "args": {"tab": "design", "camera": "front"},
     "expect": {"/camera_state/elevation": {"ge": -5, "le": 5}}},
    {"tool": "action_run", "args": {"id": "view_top"},
     "expect": {"/ran": {"eq": "orca_command:view_top:orca"}, "/camera_state/elevation": {"ge": 85}}},
    {"tool": "app_state", "expect": {"/tab": {"eq": "design"}, "/camera/elevation": {"ge": 85}}},

    // ---- Deselect All is object_select's own function: the selection of the view shown clears ----
    {"tool": "view_set", "args": {"tab": "prepare"}, "expect": {"/tab": {"eq": "prepare"}}},
    {"tool": "object_select", "args": {"objects": [0]}, "expect": {"/objects": {"eq": [0]}}},
    {"tool": "action_run", "args": {"id": "deselect_all"},
     "expect": {"/ran": {"eq": "orca_command:deselect_all:orca"}, "/empty": {"eq": true}, "/canvas": {"eq": "3d"}}},
    {"tool": "app_state", "expect": {"/selection/empty": {"eq": true}}},

    // ---- Go to tab and Go to layer take their value through action_run ----
    {"tool": "action_run", "args": {"id": "go_to_tab", "args": {"tab": "preview"}}, "expect": {"/tab": {"eq": "preview"}}},
    {"tool": "app_state", "expect": {"/tab": {"eq": "preview"}}},
    {"tool": "plate_slice", "expect": {"/status": {"eq": "done"}, "/plates/0/outcome": {"eq": "ok"}}},
    {"tool": "action_run", "args": {"id": "go_to_layer", "args": {"percent": 50}}},
    // A 20 mm cube at the X1 Carbon's 0.2 mm layers has about a hundred; half of the range is near its middle.
    {"tool": "plate_slice_stats", "args": {"include": ["view"]},
     "expect": {"/view/layer_count": {"ge": 90, "le": 110}, "/view/layers/1": {"ge": 45, "le": 56}}},

    // ---- plate_slice {preview: true} and Slice and Preview wait for the slice and show the Preview tab ----
    {"tool": "view_set", "args": {"tab": "prepare"}},
    {"tool": "object_transform", "args": {"object": 0, "translate": [5, 0, 0]}},
    {"tool": "plate_slice", "args": {"preview": true}, "expect": {"/status": {"eq": "done"}, "/plates/0/outcome": {"eq": "ok"}}},
    {"tool": "app_state", "expect": {"/tab": {"eq": "preview"}}},
    {"tool": "view_set", "args": {"tab": "prepare"}},
    {"tool": "object_transform", "args": {"object": 0, "translate": [-5, 0, 0]}},
    {"tool": "action_run", "args": {"id": "slice_and_preview"},
     "expect": {"/ran": {"eq": "orca_command:slice_and_preview:orca"}, "/status": {"eq": "done"}, "/plates/0/outcome": {"eq": "ok"}}},
    {"tool": "app_state", "expect": {"/tab": {"eq": "preview"}}},

    {"tool": "project_new", "args": {"discard_changes": true}}
  ]
}
