// Records what the import_configs command (run_action with a path) does: one preset file
// (fixtures/mcp_import_pla.json) imported while absent, kept while it exists, and replaced with on_conflict
// overwrite; a filament exported first with the Export Preset Bundle dialog, as presets.json does, kept,
// imported once deleted, and replaced; and the refusals (a path that does not exist, a file that is no preset, a
// .json that holds no preset, an overwrite argument, an on_conflict it does not take). After each it reads the
// presets the import touched, the selected presets and the undo snapshots taken since the last read
// (fixtures/ops_undo.py). It deletes the presets it made at the end, so it reruns on the same datadir. Every
// call it records is optional. Run it with
//   tools/mcp/orca_mcp.py run-replay tools/mcp/tests/ops_import_presets.json --out <dir>
{
  "orca_replay": 1,
  "name": "ops import_presets",
  "vars": {"undo": "${replay_dir}/fixtures/ops_undo.py",
           "pla": "${replay_dir}/fixtures/mcp_import_pla.json",
           "zip": "${out_dir}/Filament presets.zip"},
  "steps": [
    {"tool": "wait", "args": {"for": "ready"}},
    {"tool": "auto_answer_dialogs", "args": {"rules": [{"match": "already exists", "button": "yes"}]}},
    {"tool": "new_project", "args": {"discard_changes": true, "preset_changes": "discard"}},
    {"tool": "set_view", "args": {"tab": "prepare"}},
    {"tool": "select_preset", "args": {"type": "filament", "name": "Bambu PLA Basic", "filament_slot": 1}},
    {"tool": "delete_preset", "args": {"type": "filament", "name": "MCP Import PLA"}, "optional": true},
    {"tool": "delete_preset", "args": {"type": "filament", "name": "MCP Ops Export PLA"}, "optional": true},
    {"tool": "wait", "args": {"for": "idle"}},
    {"tool": "run_script", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"}},

    // ---- One preset file: imported, kept, replaced ----
    {"tool": "run_action", "args": {"id": "orca_command:import_configs:orca", "args": {"path": "${vars.pla}"}}, "optional": true},
    {"tool": "list_presets", "args": {"type": "filament", "query": "MCP Import PLA"}},
    {"tool": "get_app_state"},
    {"tool": "run_script", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"}},
    {"tool": "run_action", "args": {"id": "orca_command:import_configs:orca", "args": {"path": "${vars.pla}"}}, "optional": true},
    {"tool": "run_action", "args": {"id": "orca_command:import_configs:orca", "args": {"path": "${vars.pla}", "on_conflict": "overwrite"}}, "optional": true},
    {"tool": "list_presets", "args": {"type": "filament", "query": "MCP Import PLA"}},
    {"tool": "get_app_state"},
    {"tool": "run_script", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"}},

    // ---- A filament exported with the Export Preset Bundle dialog ----
    {"tool": "run_action", "args": {"id": "orca_command:toggle_developer_mode:orca"}},
    {"tool": "save_preset", "args": {"type": "filament", "name": "MCP Ops Export PLA", "detach": true, "overwrite": true}},
    {"tool": "run_action", "args": {"id": "orca_command:toggle_developer_mode:orca"}},
    {"tool": "run_action", "args": {"id": "orca_command:export_config:orca", "args": {"path": "${out_dir}"}}, "await": false, "save_as": "export"},
    {"tool": "click", "args": {"target": {"label": "Filament presets(.zip)", "within": "Export Preset Bundle"}}},
    {"tool": "set_widget_value", "args": {"target": {"name": "MCP Ops Export PLA", "within": "Export Preset Bundle"}, "value": true}},
    {"tool": "answer_dialog", "args": {"dialog": {"title": "Export Preset Bundle"}, "button": "ok"}, "await": false, "save_as": "export_ok"},
    {"tool": "get_app_state"},
    {"tool": "answer_dialog", "args": {"dialog": {"title": "Info"}, "button": "ok"}},
    {"tool": "wait", "args": {"for": "job", "job": "${jobs.export_ok}"}},
    {"tool": "wait", "args": {"for": "job", "job": "${jobs.export}"}},
    {"tool": "run_script", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"}},
    // kept while it exists, imported once deleted, replaced with on_conflict overwrite
    {"tool": "run_action", "args": {"id": "orca_command:import_configs:orca", "args": {"path": "${vars.zip}"}}, "optional": true},
    {"tool": "get_app_state"},
    {"tool": "select_preset", "args": {"type": "filament", "name": "Bambu PLA Basic", "filament_slot": 1}},
    {"tool": "delete_preset", "args": {"type": "filament", "name": "MCP Ops Export PLA"}},
    {"tool": "run_action", "args": {"id": "orca_command:import_configs:orca", "args": {"path": "${vars.zip}"}}, "optional": true},
    {"tool": "list_presets", "args": {"type": "filament", "query": "MCP Ops Export PLA"}},
    {"tool": "get_app_state"},
    {"tool": "run_action", "args": {"id": "orca_command:import_configs:orca", "args": {"path": "${vars.zip}", "on_conflict": "overwrite"}}, "optional": true},
    {"tool": "list_presets", "args": {"type": "filament", "query": "MCP Ops Export PLA"}},
    {"tool": "run_script", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"}},

    // ---- Refusals: a missing path, a file that is no preset, a .json with no preset, an overwrite, an unknown on_conflict ----
    {"tool": "run_action", "args": {"id": "orca_command:import_configs:orca", "args": {"path": "${out_dir}/missing.json"}}, "optional": true},
    {"tool": "run_action", "args": {"id": "orca_command:import_configs:orca", "args": {"path": "${replay_dir}/fixtures/heightmap.png"}}, "optional": true},
    {"tool": "run_action", "args": {"id": "orca_command:import_configs:orca", "args": {"path": "${replay_dir}/plates.json"}}, "await": false, "save_as": "nopreset", "optional": true},
    {"tool": "get_app_state"},
    {"tool": "answer_dialog", "args": {"button": "ok"}, "optional": true},
    {"tool": "answer_dialog", "args": {"button": "ok"}, "optional": true},
    {"tool": "wait", "args": {"for": "job", "job": "${jobs.nopreset}"}, "optional": true},
    {"tool": "run_action", "args": {"id": "orca_command:import_configs:orca", "args": {"path": "${vars.pla}", "overwrite": true}}, "optional": true},
    {"tool": "run_action", "args": {"id": "orca_command:import_configs:orca", "args": {"path": "${vars.pla}", "on_conflict": "merge"}}, "optional": true},
    {"tool": "get_app_state"},
    {"tool": "run_script", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"}},

    // ---- The presets it made go ----
    {"tool": "select_preset", "args": {"type": "filament", "name": "Bambu PLA Basic", "filament_slot": 1}},
    {"tool": "delete_preset", "args": {"type": "filament", "name": "MCP Import PLA"}, "optional": true},
    {"tool": "delete_preset", "args": {"type": "filament", "name": "MCP Ops Export PLA"}, "optional": true},
    {"tool": "new_project", "args": {"discard_changes": true, "preset_changes": "discard"}}
  ]
}
