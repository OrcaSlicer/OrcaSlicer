// Records what preset_import with a path does: one preset file (fixtures/mcp_import_pla.json) imported while
// absent, kept while it exists, and replaced with on_conflict overwrite; a filament exported first with the
// Export Preset Bundle dialog, as presets.json does, kept, imported once deleted, and replaced; and the refusals
// (a path that does not exist, a file that is no preset, a .json that holds no preset, an overwrite argument, an
// on_conflict it does not take). After each it reads the presets the import touched, the selected presets and
// the undo snapshots taken since the last read (fixtures/ops_undo.py). It deletes the presets it made at the
// end, so it reruns on the same datadir. Every call it records is optional. Run it with
//   tools/mcp/orca_mcp.py run-replay tools/mcp/tests/ops_import_presets.json --out <dir>
{
  "orca_replay_version": "0.2.0",
  "name": "ops import_presets",
  "vars": {"undo": "${replay_dir}/fixtures/ops_undo.py",
           "pla": "${replay_dir}/fixtures/mcp_import_pla.json",
           "zip": "${out_dir}/Filament presets.zip"},
  "steps": [
    {"tool": "app_wait", "args": {"for": "ready"}},
    {"tool": "dialog_auto_answer", "args": {"rules": [{"match": "already exists", "button": "yes"}]}},
    {"tool": "project_new", "args": {"discard_changes": true, "preset_changes": "discard"}},
    {"tool": "view_set", "args": {"tab": "prepare"}},
    {"tool": "preset_select", "args": {"type": "filament", "name": "Bambu PLA Basic", "filament_slot": 1}},
    {"tool": "preset_delete", "args": {"type": "filament", "name": "MCP Import PLA"}, "optional": true},
    {"tool": "preset_delete", "args": {"type": "filament", "name": "MCP Ops Export PLA"}, "optional": true},
    {"tool": "app_wait", "args": {"for": "idle"}},
    {"tool": "script_run", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"}},

    // ---- One preset file: imported, kept, replaced ----
    {"tool": "preset_import", "args": {"path": "${vars.pla}"}, "optional": true},
    {"tool": "preset_list", "args": {"type": "filament", "query": "MCP Import PLA"}},
    {"tool": "app_state"},
    {"tool": "script_run", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"}},
    {"tool": "preset_import", "args": {"path": "${vars.pla}"}, "optional": true},
    {"tool": "preset_import", "args": {"path": "${vars.pla}", "on_conflict": "overwrite"}, "optional": true},
    {"tool": "preset_list", "args": {"type": "filament", "query": "MCP Import PLA"}},
    {"tool": "app_state"},
    {"tool": "script_run", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"}},

    // ---- A filament exported with the Export Preset Bundle dialog ----
    {"tool": "action_run", "args": {"id": "orca_command:toggle_developer_mode:orca"}},
    {"tool": "preset_save", "args": {"type": "filament", "name": "MCP Ops Export PLA", "detach": true, "overwrite": true}},
    {"tool": "action_run", "args": {"id": "orca_command:toggle_developer_mode:orca"}},
    {"tool": "preset_export", "args": {"path": "${out_dir}"}, "await": false, "save_as": "export"},
    {"tool": "widget_click", "args": {"target": {"label": "Filament presets(.zip)", "within": "Export Preset Bundle"}}},
    {"tool": "widget_set_value", "args": {"target": {"name": "MCP Ops Export PLA", "within": "Export Preset Bundle"}, "value": true}},
    {"tool": "dialog_answer", "args": {"dialog": {"title": "Export Preset Bundle"}, "button": "ok"}, "await": false, "save_as": "export_ok"},
    {"tool": "app_state"},
    {"tool": "dialog_answer", "args": {"dialog": {"title": "Info"}, "button": "ok"}},
    {"tool": "app_wait", "args": {"for": "job", "job": "${jobs.export_ok}"}},
    {"tool": "app_wait", "args": {"for": "job", "job": "${jobs.export}"}},
    {"tool": "script_run", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"}},
    // kept while it exists, imported once deleted, replaced with on_conflict overwrite
    {"tool": "preset_import", "args": {"path": "${vars.zip}"}, "optional": true},
    {"tool": "app_state"},
    {"tool": "preset_select", "args": {"type": "filament", "name": "Bambu PLA Basic", "filament_slot": 1}},
    {"tool": "preset_delete", "args": {"type": "filament", "name": "MCP Ops Export PLA"}},
    {"tool": "preset_import", "args": {"path": "${vars.zip}"}, "optional": true},
    {"tool": "preset_list", "args": {"type": "filament", "query": "MCP Ops Export PLA"}},
    {"tool": "app_state"},
    {"tool": "preset_import", "args": {"path": "${vars.zip}", "on_conflict": "overwrite"}, "optional": true},
    {"tool": "preset_list", "args": {"type": "filament", "query": "MCP Ops Export PLA"}},
    {"tool": "script_run", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"}},

    // ---- Refusals: a missing path, a file that is no preset, a .json with no preset, an overwrite, an unknown on_conflict ----
    {"tool": "preset_import", "args": {"path": "${out_dir}/missing.json"}, "optional": true},
    {"tool": "preset_import", "args": {"path": "${replay_dir}/fixtures/heightmap.png"}, "optional": true},
    {"tool": "preset_import", "args": {"path": "${replay_dir}/plates.json"}, "await": false, "save_as": "nopreset", "optional": true},
    {"tool": "app_state"},
    {"tool": "dialog_answer", "args": {"button": "ok"}, "optional": true},
    {"tool": "dialog_answer", "args": {"button": "ok"}, "optional": true},
    {"tool": "app_wait", "args": {"for": "job", "job": "${jobs.nopreset}"}, "optional": true},
    {"tool": "preset_import", "args": {"path": "${vars.pla}", "overwrite": true}, "optional": true},
    {"tool": "preset_import", "args": {"path": "${vars.pla}", "on_conflict": "merge"}, "optional": true},
    {"tool": "app_state"},
    {"tool": "script_run", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"}},

    // ---- The presets it made go ----
    {"tool": "preset_select", "args": {"type": "filament", "name": "Bambu PLA Basic", "filament_slot": 1}},
    {"tool": "preset_delete", "args": {"type": "filament", "name": "MCP Import PLA"}, "optional": true},
    {"tool": "preset_delete", "args": {"type": "filament", "name": "MCP Ops Export PLA"}, "optional": true},
    {"tool": "project_new", "args": {"discard_changes": true, "preset_changes": "discard"}}
  ]
}
