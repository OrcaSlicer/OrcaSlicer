// Records what a new project does through its two forms, the person's (the new_project action run with action_run)
// and the silent one (project_new called with arguments): on a clean project, with unsaved project changes (a
// cube; silent: true, then discard_changes) and with unsaved preset changes (top_shell_layers 7; the action's
// question answered Discard, then Transfer when it offers that, and preset_changes keep and discard). Each call starts from the
// Home tab, so the reads show the tab it leaves. The action runs with "await": false; app_state lists its
// question, which the replay answers by its title. After each it reads the objects, the project, the presets'
// unsaved keys and the undo snapshots taken since the last read (fixtures/ops_undo.py). Plugins get the
// NewProject event on both routes, which no replay can observe without a plugin. Every call it records is
// optional. Run it with
//   tools/mcp/orca_mcp.py run-replay tools/mcp/tests/ops_new_project.json --out <dir>
{
  "orca_replay_version": "0.2.0",
  "name": "ops new_project",
  "vars": {"undo": "${replay_dir}/fixtures/ops_undo.py"},
  "steps": [
    {"tool": "app_wait", "args": {"for": "ready"}},
    {"tool": "project_new", "args": {"discard_changes": true, "preset_changes": "discard"}},

    // ---- A clean project: the action, then the command ----
    {"tool": "view_set", "args": {"tab": "home"}},
    {"tool": "app_wait", "args": {"for": "idle"}},
    {"tool": "script_run", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"}},
    {"tool": "action_run", "args": {"id": "orca_command:new_project:orca"}, "await": false, "save_as": "clean_cmd", "optional": true},
    {"tool": "app_state"},
    {"tool": "dialog_answer", "args": {"dialog": {"title": "- Save"}, "button": "no"}, "optional": true},
    {"tool": "app_wait", "args": {"for": "job", "job": "${jobs.clean_cmd}"}, "optional": true},
    {"tool": "app_wait", "args": {"for": "idle"}},
    {"tool": "app_state"},
    {"tool": "script_run", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"}},
    {"tool": "view_set", "args": {"tab": "home"}},
    {"tool": "project_new", "args": {"silent": true}, "optional": true},
    {"tool": "app_state"},
    {"tool": "script_run", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"}},

    // ---- Unsaved project changes: the action asks ----
    {"tool": "object_add_primitive", "args": {"shape": "cube", "size": [20, 20, 20]}},
    {"tool": "view_set", "args": {"tab": "home"}},
    {"tool": "app_wait", "args": {"for": "idle"}},
    {"tool": "app_state"},
    {"tool": "script_run", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"}},
    {"tool": "action_run", "args": {"id": "orca_command:new_project:orca"}, "await": false, "save_as": "dirty_cmd", "optional": true},
    {"tool": "app_state"},
    {"tool": "dialog_answer", "args": {"dialog": {"title": "- Save"}, "button": "no"}, "optional": true},
    {"tool": "app_state"},
    {"tool": "app_wait", "args": {"for": "job", "job": "${jobs.dirty_cmd}"}, "optional": true},
    {"tool": "app_wait", "args": {"for": "idle"}},
    {"tool": "app_state"},
    {"tool": "object_list"},
    {"tool": "script_run", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"}},
    // ---- the command, without discard_changes, then with it ----
    {"tool": "object_add_primitive", "args": {"shape": "cube", "size": [20, 20, 20]}},
    {"tool": "view_set", "args": {"tab": "home"}},
    {"tool": "app_wait", "args": {"for": "idle"}},
    {"tool": "script_run", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"}},
    {"tool": "project_new", "args": {"silent": true}, "optional": true},
    {"tool": "app_state"},
    {"tool": "project_new", "args": {"discard_changes": true}, "optional": true},
    {"tool": "app_state"},
    {"tool": "object_list"},
    {"tool": "script_run", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"}},

    // ---- Unsaved preset changes, no objects: the action, answered Discard ----
    {"tool": "settings_set", "args": {"values": {"top_shell_layers": 7}}},
    {"tool": "view_set", "args": {"tab": "home"}},
    {"tool": "app_wait", "args": {"for": "idle"}},
    {"tool": "app_state"},
    {"tool": "script_run", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"}},
    {"tool": "action_run", "args": {"id": "orca_command:new_project:orca"}, "await": false, "save_as": "presets_cmd", "optional": true},
    {"tool": "app_state"},
    {"tool": "dialog_answer", "args": {"dialog": {"title": "- Save"}, "button": "no"}, "optional": true},
    {"tool": "app_state"},
    {"tool": "dialog_answer", "args": {"dialog": {"title": "unsaved changes"}, "button": "Discard"}, "optional": true},
    {"tool": "app_wait", "args": {"for": "job", "job": "${jobs.presets_cmd}"}, "optional": true},
    {"tool": "app_wait", "args": {"for": "idle"}},
    {"tool": "app_state"},
    {"tool": "settings_get", "args": {"type": "process", "compare": ":saved"}},
    {"tool": "script_run", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"}},
    // ---- answered Transfer ----
    {"tool": "settings_set", "args": {"values": {"top_shell_layers": 7}}},
    {"tool": "view_set", "args": {"tab": "home"}},
    {"tool": "app_wait", "args": {"for": "idle"}},
    {"tool": "action_run", "args": {"id": "orca_command:new_project:orca"}, "await": false, "save_as": "presets_cmd2", "optional": true},
    {"tool": "app_state"},
    {"tool": "dialog_answer", "args": {"dialog": {"title": "- Save"}, "button": "no"}, "optional": true},
    {"tool": "dialog_answer", "args": {"dialog": {"title": "unsaved changes"}, "button": "Transfer"}, "optional": true},
    {"tool": "dialog_answer", "args": {"dialog": {"title": "unsaved changes"}, "button": "Discard"}, "optional": true},
    {"tool": "app_wait", "args": {"for": "job", "job": "${jobs.presets_cmd2}"}, "optional": true},
    {"tool": "app_wait", "args": {"for": "idle"}},
    {"tool": "app_state"},
    {"tool": "settings_get", "args": {"type": "process", "compare": ":saved"}},
    {"tool": "script_run", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"}},
    // ---- the command: no discard_changes, then preset_changes keep (default) and discard ----
    {"tool": "project_new", "args": {"discard_changes": true, "preset_changes": "discard"}},
    {"tool": "settings_set", "args": {"values": {"top_shell_layers": 7}}},
    {"tool": "view_set", "args": {"tab": "home"}},
    {"tool": "app_wait", "args": {"for": "idle"}},
    {"tool": "script_run", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"}},
    {"tool": "project_new", "args": {"silent": true}, "optional": true},
    {"tool": "app_state"},
    {"tool": "project_new", "args": {"discard_changes": true}, "optional": true},
    {"tool": "app_state"},
    {"tool": "settings_get", "args": {"type": "process", "compare": ":saved"}},
    {"tool": "script_run", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"}},
    {"tool": "view_set", "args": {"tab": "home"}},
    {"tool": "project_new", "args": {"discard_changes": true, "preset_changes": "discard"}, "optional": true},
    {"tool": "app_state"},
    {"tool": "settings_get", "args": {"type": "process", "compare": ":saved"}},
    {"tool": "script_run", "args": {"filename": "${vars.undo}", "code": "import ops_undo\nresult = ops_undo.taken()"}},

    {"tool": "project_new", "args": {"discard_changes": true, "preset_changes": "discard"}}
  ]
}
