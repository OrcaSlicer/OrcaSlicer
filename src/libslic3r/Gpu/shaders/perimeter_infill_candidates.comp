#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

// Exact scanline-intersection generation.  Final polygon clipping, winding
// classification and ordering still consume stable IDs and pass the host
// exact-reference checks before an extrusion path is committed.
// glslc versions bundled with some Windows Vulkan SDKs emit LocalSize=1 for
// LocalSizeId. The build produces fixed 64/128/256/512/1024 variants instead;
// the runtime benchmarks the actual GPU and loads the fastest one.
#ifndef ORCA_WORKGROUP_SIZE
#define ORCA_WORKGROUP_SIZE 256
#endif
layout(local_size_x = ORCA_WORKGROUP_SIZE) in;

struct IntersectionRequest {
    int64_t ax;
    int64_t ay;
    int64_t bx;
    int64_t by;
    int64_t scan_x;
    uint64_t stable_id;
};

struct IntersectionResult {
    int64_t numerator;
    int64_t denominator;
    uint64_t stable_id;
    uint valid;
    uint reserved;
};

layout(std430, binding = 0) readonly buffer InputRequests {
    IntersectionRequest input_requests[];
};

layout(std430, binding = 1) writeonly buffer OutputResults {
    IntersectionResult output_results[];
};

void main()
{
    const uint index = gl_GlobalInvocationID.x;
    if (index >= input_requests.length())
        return;

    const IntersectionRequest request = input_requests[index];
    IntersectionResult result;
    result.stable_id = request.stable_id;
    result.numerator = 0l;
    result.denominator = 1l;
    result.valid = 0u;
    result.reserved = 0u;

    // Endpoint intersections are deliberately excluded. Their inclusion and
    // tangency rules are topology-sensitive and remain in the CPU reference.
    const int64_t lower_x = min(request.ax, request.bx);
    const int64_t upper_x = max(request.ax, request.bx);
    if (request.ax != request.bx && request.scan_x > lower_x && request.scan_x < upper_x) {
        const bool forward = request.bx > request.ax;
        result.numerator = forward ? request.scan_x - request.ax : request.ax - request.scan_x;
        result.denominator = forward ? request.bx - request.ax : request.ax - request.bx;
        result.numerator = result.numerator * (request.by - request.ay) + request.ay * result.denominator;
        result.valid = 1u;
    }

    output_results[index] = result;
}
