FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update -qq && apt-get install -y -qq \
    cmake ninja-build g++ git ccache wget unzip bzip2 xz-utils \
    libssl-dev libdbus-1-dev libeigen3-dev \
    qtbase5-dev qtdeclarative5-dev \
    libboost-dev libboost-filesystem-dev libboost-thread-dev \
    libboost-log-dev libboost-locale-dev libboost-regex-dev \
    libboost-chrono-dev libboost-atomic-dev libboost-date-time-dev \
    libboost-iostreams-dev libboost-program-options-dev libboost-nowide-dev \
    libboost-system-dev \
    libtbb-dev \
    zlib1g-dev libbz2-dev liblzma-dev \
    libpng-dev libjpeg-dev libtiff-dev \
    libxml2-dev libsqlite3-dev libcurl4-openssl-dev \
    libexpat1-dev \
    libgl1-mesa-dev libglu1-mesa-dev \
    libcgal-dev \
    libglfw3-dev \
    libcereal-dev \
    libnlopt-dev \
    libnoise-dev \
    libassimp-dev \
    libocct-foundation-dev \
    libocct-modeling-algorithms-dev \
    libjpeg-dev \
    libdraco-dev \
    libwxgtk3.2-dev \
    libwxgtk-media3.2-dev \
    libwxgtk-webview3.2-dev \
    libgtk-3-dev \
    libsecret-1-dev \
    libwebkit2gtk-4.1-dev \
    libopencv-dev \
    libgmp-dev \
    libmpfr-dev \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Install nlopt.hpp symlink (libnlopt-dev installs nlopt.h, libnest2d needs nlopt.hpp)
RUN ln -sf /usr/include/nlopt.h /usr/include/nlopt.hpp

WORKDIR /repo
