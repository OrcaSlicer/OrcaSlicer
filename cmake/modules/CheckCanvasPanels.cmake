# Checks that the panels drawn over the 3D scene go through the CanvasUi toolkit only: no ImGui,
# ImGuiWrapper or toolkit-internal header is included and no ImGui name is used outside comments and
# string literals; and that every GUI file, in any subfolder, that includes a toolkit header is among them. Run as a
# script at build time:
#   cmake -DFILES_LIST=<file with the paths> -DCANDIDATES_LIST=<file with the GUI sources> -DGUI_DIR=<src/slic3r/GUI>
#         -DFIXTURES=<dir> -DSTAMP=<file> -P CheckCanvasPanels.cmake

set(CANVAS_PANELS_EXEMPT
    # The canvas: it starts and ends the toolkit's frame and owns its context.
    GLCanvas3D.cpp GLCanvas3D.hpp
    # The ImGui wrapper: it loads the toolkit's bold and monospaced faces.
    ImGuiWrapper.cpp ImGuiWrapper.hpp
    # It keeps the texture of the toolkit's icons with the other OpenGL resources.
    OpenGLManager.cpp
    # The preview and its rails draw through ImGuiWrapper and only lay out beside the panels by the toolkit's rectangles.
    GCodeViewer.cpp GCodeViewer.hpp IMSlider.hpp
)

# The text with comments and string and character literals blanked, newlines kept, so that line
# numbers still match.
function(canvas_panels_code text out_var)
    set(code "")
    set(rest "${text}")
    while(TRUE)
        set(next -1)
        set(kind "")
        foreach(token "//" "/*" "R\"" "\"" "'")
            string(FIND "${rest}" "${token}" at)
            if(token STREQUAL "'" AND at GREATER 0)
                # A quote after a digit separates thousands, as in 1'000, and opens no literal.
                math(EXPR before_at "${at} - 1")
                string(SUBSTRING "${rest}" ${before_at} 1 previous)
                while(previous MATCHES "[0-9A-Fa-f]" AND at GREATER -1)
                    math(EXPR from_at "${at} + 1")
                    string(SUBSTRING "${rest}" ${from_at} -1 tail)
                    string(FIND "${tail}" "'" next_quote)
                    if(next_quote EQUAL -1)
                        set(at -1)
                    else()
                        math(EXPR at "${from_at} + ${next_quote}")
                        math(EXPR before_at "${at} - 1")
                        string(SUBSTRING "${rest}" ${before_at} 1 previous)
                    endif()
                endwhile()
            endif()
            if(at GREATER -1 AND (next EQUAL -1 OR at LESS next))
                set(next ${at})
                set(kind "${token}")
            endif()
        endforeach()
        if(next EQUAL -1)
            string(APPEND code "${rest}")
            break()
        endif()
        string(SUBSTRING "${rest}" 0 ${next} before)
        string(APPEND code "${before}")
        string(LENGTH "${kind}" kind_length)
        math(EXPR after "${next} + ${kind_length}")
        string(SUBSTRING "${rest}" ${after} -1 rest)
        if(kind STREQUAL "//")
            string(FIND "${rest}" "\n" end)
        elseif(kind STREQUAL "/*")
            string(FIND "${rest}" "*/" end)
        elseif(kind STREQUAL "R\"")
            # A raw string ends at its closing parenthesis, delimiter and quote.
            string(FIND "${rest}" "(" open)
            string(SUBSTRING "${rest}" 0 ${open} delimiter)
            string(FIND "${rest}" ")${delimiter}\"" end)
        else()
            set(end -1)
            set(from 0)
            while(TRUE)
                string(SUBSTRING "${rest}" ${from} -1 tail)
                string(FIND "${tail}" "${kind}" at)
                if(at EQUAL -1)
                    break()
                endif()
                math(EXPR at "${from} + ${at}")
                set(backslashes 0)
                set(i ${at})
                while(i GREATER 0)
                    math(EXPR i "${i} - 1")
                    string(SUBSTRING "${rest}" ${i} 1 c)
                    if(NOT c STREQUAL "\\")
                        break()
                    endif()
                    math(EXPR backslashes "${backslashes} + 1")
                endwhile()
                math(EXPR odd "${backslashes} % 2")
                if(odd EQUAL 0)
                    set(end ${at})
                    break()
                endif()
                math(EXPR from "${at} + 1")
            endwhile()
        endif()
        if(end EQUAL -1)
            break()
        endif()
        string(SUBSTRING "${rest}" 0 ${end} skipped)
        string(REGEX REPLACE "[^\n]" "" kept_newlines "${skipped}")
        string(APPEND code " ${kept_newlines}")
        if(kind STREQUAL "//")
            string(SUBSTRING "${rest}" ${end} -1 rest)
        elseif(kind STREQUAL "/*")
            math(EXPR end "${end} + 2")
            string(SUBSTRING "${rest}" ${end} -1 rest)
        elseif(kind STREQUAL "R\"")
            string(LENGTH ")${delimiter}\"" closing)
            math(EXPR end "${end} + ${closing}")
            string(SUBSTRING "${rest}" ${end} -1 rest)
        else()
            math(EXPR end "${end} + 1")
            string(SUBSTRING "${rest}" ${end} -1 rest)
        endif()
    endwhile()
    set(${out_var} "${code}" PARENT_SCOPE)
endfunction()

# Lines of text as a CMake list, with the characters that CMake lists treat specially blanked.
function(canvas_panels_lines text out_var)
    string(REGEX REPLACE "[][;\\\\]" " " text "${text}")
    string(REPLACE "\n" ";" text "${text}")
    set(${out_var} "${text}" PARENT_SCOPE)
endfunction()

# "<file>:<line>: <what>" for every violation in file.
function(canvas_panels_violations file out_var)
    file(READ "${file}" text)
    canvas_panels_code("${text}" code)
    canvas_panels_lines("${text}" raw_lines)
    canvas_panels_lines("${code}" code_lines)
    set(found "")
    set(number 0)
    foreach(line IN LISTS code_lines)
        list(GET raw_lines ${number} raw)
        math(EXPR number "${number} + 1")
        if(line MATCHES "^[ \t]*#[ \t]*include" AND raw MATCHES "#[ \t]*include[ \t]*[<\"]([^>\"]*)[>\"]")
            set(header "${CMAKE_MATCH_1}")
            if(header MATCHES "imgui|ImGuiWrapper|ComponentParts\\.hpp|ImGuiBridge\\.hpp|CanvasFrame\\.hpp")
                list(APPEND found "${file}:${number}: includes ${header}")
            endif()
        elseif(line MATCHES "(^|[^A-Za-z0-9_])(ImGui[A-Za-z0-9_]*|GImGui|Im[A-Z][A-Za-z0-9_]*|IM_[A-Z][A-Za-z0-9_]*)")
            list(APPEND found "${file}:${number}: names ${CMAKE_MATCH_2}")
        endif()
    endforeach()
    set(${out_var} "${found}" PARENT_SCOPE)
endfunction()

function(canvas_panels_unlisted file gui_dir files out_var)
    set(${out_var} "" PARENT_SCOPE)
    get_filename_component(name "${file}" NAME)
    string(FIND "${file}" "${gui_dir}/" in_gui)
    string(FIND "${file}" "${gui_dir}/CanvasUi/" in_toolkit)
    if(NOT in_gui EQUAL 0 OR in_toolkit EQUAL 0 OR name IN_LIST CANVAS_PANELS_EXEMPT OR file IN_LIST files)
        return()
    endif()
    file(STRINGS "${file}" toolkit_includes REGEX "#[ \t]*include[ \t]*[<\"][^>\"]*CanvasUi/[^>\"]*[>\"]")
    if(toolkit_includes)
        set(${out_var} "${file}: draws over the scene through CanvasUi, but is not in SLIC3R_CANVAS_PANEL_SOURCES" PARENT_SCOPE)
    endif()
endfunction()

if(CMAKE_SCRIPT_MODE_FILE)
    file(READ "${FILES_LIST}" FILES)
    file(GLOB bad_examples "${FIXTURES}/bad_*")
    file(GLOB good_examples "${FIXTURES}/good_*")
    if(NOT bad_examples OR NOT good_examples)
        message(FATAL_ERROR "CheckCanvasPanels: no examples in ${FIXTURES}")
    endif()
    foreach(example IN LISTS bad_examples)
        canvas_panels_violations("${example}" found)
        if(NOT found)
            message(FATAL_ERROR "CheckCanvasPanels: ${example} breaks the rule, but nothing was found")
        endif()
    endforeach()
    foreach(example IN LISTS good_examples)
        canvas_panels_violations("${example}" found)
        if(found)
            list(JOIN found "\n" found)
            message(FATAL_ERROR "CheckCanvasPanels: ${example} keeps the rule, but this was found:\n${found}")
        endif()
    endforeach()
    file(GLOB_RECURSE unlisted_examples "${FIXTURES}/GUI/*")
    if(NOT unlisted_examples)
        message(FATAL_ERROR "CheckCanvasPanels: no unlisted examples in ${FIXTURES}/GUI")
    endif()
    foreach(example IN LISTS unlisted_examples)
        canvas_panels_unlisted("${example}" "${FIXTURES}/GUI" "" found)
        if(NOT found)
            message(FATAL_ERROR "CheckCanvasPanels: ${example} is not listed, but nothing was found")
        endif()
    endforeach()

    set(all "")
    foreach(file IN LISTS FILES)
        canvas_panels_violations("${file}" found)
        list(APPEND all ${found})
    endforeach()
    file(READ "${CANDIDATES_LIST}" CANDIDATES)
    foreach(file IN LISTS CANDIDATES)
        canvas_panels_unlisted("${file}" "${GUI_DIR}" "${FILES}" found)
        list(APPEND all ${found})
    endforeach()
    if(all)
        list(JOIN all "\n" all)
        message(FATAL_ERROR "Panels over the scene go through CanvasUi only:\n${all}")
    endif()
    file(TOUCH "${STAMP}")
endif()
