msgstr "Centre Arc — คลิกจุดเริ่ม (กำหนดรัศมี)"

msgid "Centre arc — click the end point"
msgstr "Centre Arc — คลิกจุดจบ"

msgid "Slot — click one end of the centreline"
msgstr "Slot — คลิกปลายหนึ่งของเส้นกลาง"

msgid "Slot — click the other end of the centreline"
msgstr "Slot — คลิกอีกปลายของเส้นกลาง"

msgid "Slot — click to set the width"
msgstr "Slot — คลิกเพื่อกำหนดความกว้าง"

