msgstr ""
"%s\n"
"\n"
"ปริมาตร: %.3f ซม.³\n"
"พื้นที่ผิว: %.2f ซม.²"

msgid "Pattern needs a solid body — add or import one first"
msgstr "Pattern ต้องมีชิ้นงานตนก่อน สร้างหรือนำเข้าชิ้นหนึ่งก่อนนะ"

msgid "Boolean needs two solid bodies — add or import a second one"
msgstr "Boolean ต้องมีชิ้นงานตันสองชิ้น นำเข้าหรือสร้างชิ้นที่สองก่อน"

msgid "Cut needs a solid body — add or import one first"
msgstr "Cut ต้องมีชิ้นงานตนก่อน สร้างหรือนำเข้าชิ้นหนึ่งก่อนนะ"

#, c-format, boost-format
msgid "the picked face of Body %d"
msgstr "หน้าที่เลือกของชิ้นงาน %d"

msgid "the picked face"
msgstr "หน้าที่เลือก"

#, c-format, boost-format
msgid "  ·  %d picked"
msgstr "  ·  เลือกแล้ว %d"

#, c-format, boost-format
msgid "%d selected  ·  Del removes them  ·  Shift-click adds  ·  double-click takes the whole loop"
msgstr "เลือก %d ชิ้น  ·  กด Del เพื่อลบ  ·  Shift-คลิกเพื่อเลือกเพิ่ม  ·  ดับเบิลคลิกเพื่อเลือกทั้งวง"

msgid "Select — click an entity to pick it  ·  drag an endpoint or centre to move it  ·  Shift-click adds  ·  Del removes"
msgstr "เลือก — คลิกเส้นเพื่อเลือก  ·  ลากปลายหรือจุดกลางเพื่อขยับ  ·  Shift-คลิกเพื่อเพิ่ม  ·  Del เพื่อลบ"

#, c-format, boost-format
msgid "%d picked  ·  now choose a constraint (Horizontal, Parallel, Tangent, Equal…)"
msgstr "เลือกแล้ว %d  ·  เลือกเงื่อนไขล็อก เช่น Horizontal, Parallel, Tangent, Equal…"

msgid "Constrain — click one or two entities, then choose a constraint"
msgstr "Constrain — คลิกหนึ่งหรือสองเส้น แล้วเลือกเงื่อนไขล็อก"

