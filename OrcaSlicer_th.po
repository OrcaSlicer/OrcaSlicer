msgstr "Circle (3 จุด) — คลิกจุดที่สาม"

msgid "Arc — click the start point"
msgstr "Arc — คลิกจุดเริ่ม"

msgid "Arc — click the end point"
msgstr "Arc — คลิกจุดจบ"

msgid "Arc — click a point the arc passes through"
msgstr "Arc — คลิกจุดที่โค้งต้องผ่าน"

