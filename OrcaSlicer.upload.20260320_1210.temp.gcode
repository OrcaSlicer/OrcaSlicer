;START_OF_HEADER
;HEADER_VERSION:0.1
;FLAVOR:Griffin
;GENERATOR.NAME:OrcaSlicer
;GENERATOR.VERSION:5.11.0
;GENERATOR.BUILD_DATE:2016-06-23
;TARGET_MACHINE.NAME:UltiMaker S5
;EXTRUDER_TRAIN.0.INITIAL_TEMPERATURE:220
;EXTRUDER_TRAIN.0.MATERIAL.VOLUME_USED:0
;EXTRUDER_TRAIN.0.MATERIAL.GUID:506c9f0d-e3aa-4bd4-b2d2-23e2425b1aa9
;EXTRUDER_TRAIN.0.NOZZLE.DIAMETER:0.4
;EXTRUDER_TRAIN.0.NOZZLE.NAME:AA 0.4
;BUILD_PLATE.INITIAL_TEMPERATURE:55
;BUILD_VOLUME.TEMPERATURE:28
;PRINT.TIME:2
;PRINT.SIZE.MIN.X:0
;PRINT.SIZE.MIN.Y:0
;PRINT.SIZE.MIN.Z:0
;PRINT.SIZE.MAX.X:200
;PRINT.SIZE.MAX.Y:200
;PRINT.SIZE.MAX.Z:200
;END_OF_HEADER
T0

M82 ;absolute extrusion mode
G92 E0
M190 S55 ; Wait for bed temp
M104 S220 ; Heat extruder
M109 S220 ; Wait for extruder temp


; Set the settings we removed in the post-processing (orcaslicer generated header).
M73 P0 R0 ;TODO change the R value into the total minutes of print
M201 X3500 Y3500 Z500 E10000 ; accel
M203 X500 Y500 Z12 E120 ; max speed
M204 S1500 ; starting accel
M204 P1500 R1500 T3500
M205 X20 Y20 Z0.4 E2.5 ; jerk limits


; Now do the other regular start gcode stuff

;G21; metric values
;G90; absolute positioning
;M82 ; set extruder to absolute mode

M107; start with the fan off

; M140 S55; start bed heating

; G28 X0 Y0 Z0; move X/Y/Z to endstops ; DISABLED bc ultimaker doesn't implement G28
;G1 X1 Y6 F15000; move X/Y to start position
;G1 Z35 F9000; move Z to start position

; Wait for bed and nozzle temperatures
; M190 S50; wait for bed temperature - 5
; M140 S55; continue bed heating
; M109 S220; wait for nozzle temperature


; Make the prime blob
G0 F9000 X-3 Y6 Z2
G280 ; g280 is UM-specific
G1 F2700 E-6.5 ;retract

M82; set extruder to absolute mode
;LAYER_COUNT:266
G90
G21
M82 ; use absolute distances for extrusion
G92 E0
; Filament gcode
M106 S0
;LAYER_CHANGE
;Z:0.25
;HEIGHT:0.25
;BEFORE_LAYER_CHANGE
;0.25

; The below line was removed because absolute extrusion is necessary
;G92 E0

G1 E-4.5 F2700
G92 E0
;LAYER:0

;_SET_FAN_SPEED_CHANGING_LAYER
G1 X87.802 Y102.235 F3600
G1 Z1.25
G1 Z.25
G1 E4.5 F2700
